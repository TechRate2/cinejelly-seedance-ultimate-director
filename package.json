{
  "name": "cinejelly-seedance-ultimate-director",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Production-grade agentic video pipeline for Seedance 2.0 through Atlas Cloud.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local-env.mjs",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "doctor": "node scripts/run-doctor.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "preflight": "npm run build && node --env-file-if-exists=.env dist/application/preflight-entrypoint.js",
    "validation:readiness": "npm run build && node --env-file-if-exists=.env dist/application/validation-readiness-entrypoint.js",
    "validation:create-request": "node scripts/create-validation-request.mjs",
    "validation:local-smoke": "node scripts/run-local-validation-smoke.mjs",
    "validation:client-policy-smoke": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/run-client-policy-smoke.mjs",
    "validation:deployment-readiness": "node scripts/capture-deployment-readiness.mjs",
    "validation:long-form": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --env-file-if-exists=.env scripts/run-long-form-validation.mjs",
    "validation:source-video-auto-analysis": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --env-file-if-exists=.env scripts/run-source-video-auto-analysis-validation.mjs",
    "validation:remote-stock": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --env-file-if-exists=.env scripts/run-remote-stock-validation.mjs",
    "validation:generated-audio": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --env-file-if-exists=.env scripts/run-atlas-generated-audio-validation.mjs",
    "validation:billing-admin-ops": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --env-file-if-exists=.env scripts/capture-billing-admin-ops.mjs",
    "validation:production-ops": "node --env-file-if-exists=.env scripts/capture-production-operations.mjs",
    "validation:ops-config": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --env-file-if-exists=.env scripts/validate-business-readiness-ops-config.mjs",
    "validation:business-plan": "node --env-file-if-exists=.env scripts/plan-business-readiness-validation.mjs",
    "validation:release-audit": "node scripts/run-release-audit.mjs",
    "validation:render-request": "npm run build && node --env-file-if-exists=.env dist/application/render-request-validation-entrypoint.js",
    "validation:paid-render": "npm run build && node --env-file-if-exists=.env dist/application/paid-render-validation-entrypoint.js",
    "validation:business-readiness": "node scripts/run-business-readiness-audit.mjs",
    "validate:artifacts": "npm run build && node --env-file-if-exists=.env dist/application/artifact-validation-entrypoint.js",
    "ops:create-client-policy": "node scripts/create-api-client-policy-kit.mjs",
    "ops:apply-client-policy-env": "node scripts/apply-client-policy-env.mjs",
    "start": "node --env-file-if-exists=.env dist/api/server.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
