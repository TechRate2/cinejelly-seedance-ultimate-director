{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/business-completion-audit-report.schema.json",
  "title": "CineJelly Business Completion Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "checkedInputs",
    "sourceReports",
    "readinessSnapshot",
    "commercialOfferScopeSummary",
    "operatorHandoffSummary",
    "codeWorkSummary",
    "productCodeGaps",
    "blockerSummary",
    "blockers",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.business-completion-audit.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "ready_for_customer_traffic",
        "ready_for_live_evidence_sequence",
        "blocked_by_external_inputs",
        "blocked_by_code_or_contracts",
        "missing_prerequisite_reports"
      ]
    },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "businessReadinessPath",
        "businessPlanPath",
        "liveInputsPath",
        "commercialInputsPath",
        "launchIntakePath",
        "releaseAuditPath",
        "snapshotParityPath",
        "reportContractsPath",
        "commercialLaunchDoctorPath",
        "commercialLaunchDoctorSkipped",
        "opsConfigPath"
      ],
      "properties": {
        "businessReadinessPath": { "type": "string" },
        "businessPlanPath": { "type": "string" },
        "liveInputsPath": { "type": "string" },
        "commercialInputsPath": { "type": "string" },
        "launchIntakePath": { "type": "string" },
        "releaseAuditPath": { "type": "string" },
        "snapshotParityPath": { "type": "string" },
        "reportContractsPath": { "type": "string" },
        "commercialLaunchDoctorPath": { "type": "string" },
        "commercialLaunchDoctorSkipped": { "type": "boolean" },
        "opsConfigPath": { "type": "string" },
        "markdownOutputPath": { "type": "string" }
      }
    },
    "sourceReports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["present", "path", "status"],
        "properties": {
          "present": { "type": "boolean" },
          "path": { "type": "string" },
          "schemaVersion": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "readinessSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceCompletionPercent",
        "businessReadinessStatus",
        "releaseAuditStatus",
        "snapshotParityStatus",
        "reportContractsStatus",
        "commercialInputsStatus",
        "launchDoctorStatus",
        "opsConfigStatus",
        "launchDoctorKnownCodeBlockingIssueCount",
        "commandPlanAuditStatus",
        "atlas",
        "budget",
        "readyPaidGates",
        "readyPaidGateCount",
        "shouldDeferFullSequenceSpend",
        "canRunGeneratedAudioPaidSlice",
        "canRunFullKnownPaidSequence",
        "canReleaseToCustomerTraffic"
      ],
      "properties": {
        "evidenceCompletionPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "businessReadinessStatus": { "type": "string" },
        "releaseAuditStatus": { "type": "string" },
        "snapshotParityStatus": { "type": "string" },
        "reportContractsStatus": { "type": "string" },
        "commercialInputsStatus": { "type": "string" },
        "launchDoctorStatus": { "type": "string" },
        "opsConfigStatus": { "type": "string" },
        "launchDoctorKnownCodeBlockingIssueCount": { "type": "integer", "minimum": 0 },
        "commandPlanAuditStatus": { "type": "string" },
        "atlas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mediaApiKeyConfigured",
            "llmApiKeyConfigured",
            "llmFallbackAvailable",
            "mediaReady",
            "llmReady",
            "seedanceVideoReady",
            "generatedAudioReady",
            "generatedAudioPaidSliceReady",
            "fullPaidSequenceWithinBudget"
          ],
          "properties": {
            "mediaApiKeyConfigured": { "type": "boolean" },
            "llmApiKeyConfigured": { "type": "boolean" },
            "llmFallbackAvailable": { "type": "boolean" },
            "mediaReady": { "type": "boolean" },
            "llmReady": { "type": "boolean" },
            "seedanceVideoReady": { "type": "boolean" },
            "generatedAudioReady": { "type": "boolean" },
            "generatedAudioPaidSliceReady": { "type": "boolean" },
            "fullPaidSequenceWithinBudget": { "type": "boolean" }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["budgetFit", "unknownCostItems"],
          "properties": {
            "approvedBudgetUsd": { "type": "number", "minimum": 0 },
            "knownPaidEstimateUsd": { "type": "number", "minimum": 0 },
            "budgetFit": { "type": "string" },
            "longFormMinimumBudgetUsd": { "type": "number", "minimum": 0 },
            "generatedAudioEstimatedCostUsd": { "type": "number", "minimum": 0 },
            "unknownCostItems": { "type": "array", "items": { "type": "string" } }
          }
        },
        "readyPaidGates": { "type": "array", "items": { "type": "string" } },
        "readyPaidGateCount": { "type": "integer", "minimum": 0 },
        "shouldDeferFullSequenceSpend": { "type": "boolean" },
        "canRunGeneratedAudioPaidSlice": { "type": "boolean" },
        "canRunFullKnownPaidSequence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "type": "boolean" }
      }
    },
    "commercialOfferScopeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchIntakePresent",
        "launchIntakeStatus",
        "configured",
        "status",
        "uiRequiredBeforeCustomerTraffic",
        "scopeDecisionRequired",
        "blocksApiCliCommercialLaunch",
        "blocksFullSnapshotParity",
        "sourceReport",
        "message"
      ],
      "properties": {
        "launchIntakePresent": { "type": "boolean" },
        "launchIntakeStatus": { "type": "string" },
        "configured": { "type": "boolean" },
        "status": {
          "enum": [
            "missing_launch_intake_report",
            "scope_decision_pending",
            "api_cli_only_scoped",
            "first_party_web_ui_required"
          ]
        },
        "productSurface": { "enum": ["api_cli_only", "first_party_web_ui_required"] },
        "uiRequiredBeforeCustomerTraffic": { "type": "boolean" },
        "scopeDecisionRequired": { "type": "boolean" },
        "blocksApiCliCommercialLaunch": { "type": "boolean" },
        "blocksFullSnapshotParity": { "type": "boolean" },
        "sourceReport": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "operatorHandoffSummary": { "$ref": "#/$defs/operatorHandoffSummary" },
    "codeWorkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportContractsPass",
        "releaseAuditReady",
        "snapshotParityPass",
        "commercialInputsGenerated",
        "commercialCommandPlanPass",
        "atlasKeyAndModelConfigPresent",
        "knownCodeBlockingIssueCount",
        "knownProductCodeGapCount",
        "automatableProductCodeGapCount",
        "externalEvidenceProductCodeGapCount",
        "scopeDecisionProductCodeGapCount",
        "blocksFullSnapshotParity",
        "blocksApiCliCommercialLaunch",
        "message"
      ],
      "properties": {
        "reportContractsPass": { "type": "boolean" },
        "releaseAuditReady": { "type": "boolean" },
        "snapshotParityPass": { "type": "boolean" },
        "commercialInputsGenerated": { "type": "boolean" },
        "commercialCommandPlanPass": { "type": "boolean" },
        "atlasKeyAndModelConfigPresent": { "type": "boolean" },
        "knownCodeBlockingIssueCount": { "type": "integer", "minimum": 0 },
        "knownProductCodeGapCount": { "type": "integer", "minimum": 0 },
        "automatableProductCodeGapCount": { "type": "integer", "minimum": 0 },
        "externalEvidenceProductCodeGapCount": { "type": "integer", "minimum": 0 },
        "scopeDecisionProductCodeGapCount": { "type": "integer", "minimum": 0 },
        "blocksFullSnapshotParity": { "type": "boolean" },
        "blocksApiCliCommercialLaunch": { "type": "boolean" },
        "message": { "type": "string" }
      }
    },
    "productCodeGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "category",
          "status",
          "currentCoveragePercent",
          "sourceEvidence",
          "sourcePatternOrigins",
          "requiredAction",
          "canAutomateNow",
          "localPreparationAvailable",
          "completionRequiresExternalEvidence",
          "remainingEvidenceGateCount",
          "scopeDecisionRequired",
          "scopeDecisionOptions",
          "blocksApiCliCommercialLaunch",
          "blocksFullSnapshotParity",
          "releaseImpact"
        ],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "category": { "type": "string" },
          "status": { "type": "string" },
          "currentCoveragePercent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "sourceEvidence": { "type": "string" },
          "sourcePatternOrigins": { "type": "array", "items": { "type": "string" } },
          "requiredAction": { "type": "string" },
          "canAutomateNow": { "type": "boolean" },
          "localPreparationAvailable": { "type": "boolean" },
          "completionRequiresExternalEvidence": { "type": "boolean" },
          "remainingEvidenceGateCount": { "type": "integer", "minimum": 0 },
          "scopeDecisionRequired": { "type": "boolean" },
          "scopeDecisionOptions": { "type": "array", "items": { "type": "string" } },
          "blocksApiCliCommercialLaunch": { "type": "boolean" },
          "blocksFullSnapshotParity": { "type": "boolean" },
          "releaseImpact": { "type": "string" }
        }
      }
    },
    "blockerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "automatableNow", "externalOrPaid", "byOwner", "byCategory"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "automatableNow": { "type": "integer", "minimum": 0 },
        "externalOrPaid": { "type": "integer", "minimum": 0 },
        "byOwner": { "$ref": "#/$defs/counts" },
        "byCategory": { "$ref": "#/$defs/counts" }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "owner",
          "category",
          "status",
          "sourceReport",
          "requiredAction",
          "canAutomateNow",
          "paidImpact"
        ],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "owner": {
            "enum": [
              "codebase",
              "operator",
              "budget_owner",
              "manual_reviewer",
              "operator_external_provider"
            ]
          },
          "category": { "type": "string" },
          "status": { "type": "string" },
          "sourceReport": { "type": "string" },
          "sourceCheck": { "type": "string" },
          "requiredAction": { "type": "string" },
          "validationCommand": { "type": "string" },
          "canAutomateNow": { "type": "boolean" },
          "paidImpact": {
            "enum": [
              "none",
              "blocks_paid_validation_budget",
              "blocks_paid_validation_or_manual_review"
            ]
          }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canReleaseToCustomerTraffic",
        "canRunNoSpendPrep",
        "canRunLiveNetworkEvidence",
        "canRunGeneratedAudioPaidSlice",
        "canRunFullKnownPaidSequence",
        "canClaimFullSnapshotParity",
        "productCodeGapCount",
        "readyPaidGates",
        "readyPaidGateCount",
        "shouldDeferFullSequenceSpend",
        "safeToRunFullPaidAtlasSequenceNow",
        "releaseBlocker"
      ],
      "properties": {
        "canReleaseToCustomerTraffic": { "type": "boolean" },
        "canRunNoSpendPrep": { "type": "boolean" },
        "canRunLiveNetworkEvidence": { "type": "boolean" },
        "canRunGeneratedAudioPaidSlice": { "type": "boolean" },
        "canRunFullKnownPaidSequence": { "type": "boolean" },
        "canClaimFullSnapshotParity": { "type": "boolean" },
        "productCodeGapCount": { "type": "integer", "minimum": 0 },
        "readyPaidGates": { "type": "array", "items": { "type": "string" } },
        "readyPaidGateCount": { "type": "integer", "minimum": 0 },
        "shouldDeferFullSequenceSpend": { "type": "boolean" },
        "safeToRunFullPaidAtlasSequenceNow": { "type": "boolean" },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "string" }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "operatorHandoffSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "safeToShareWithOperators",
        "releaseEvidence",
        "secretValuesIncluded",
        "rawProviderPayloadsIncluded",
        "localAbsolutePathsIncluded",
        "customerMediaIncluded",
        "requiredInputCount",
        "configuredInputCount",
        "missingOrBlockedInputCount",
        "pendingAfterPaidRunCount",
        "operatorInputFileCount",
        "draftFileCount",
        "reportArchiveFileCount",
        "commandCount",
        "readyCommandCount",
        "blockedCommandCount",
        "paidCommandCount",
        "readyPaidCommandCount",
        "commandPlanAuditStatus",
        "blockedInputIds",
        "operatorInputFiles",
        "refreshCommands"
      ],
      "properties": {
        "source": {
          "enum": [
            "commercial_launch_inputs",
            "missing_commercial_launch_inputs_manifest"
          ]
        },
        "status": { "type": "string" },
        "safeToShareWithOperators": { "type": "boolean" },
        "releaseEvidence": { "type": "boolean" },
        "secretValuesIncluded": { "type": "boolean" },
        "rawProviderPayloadsIncluded": { "type": "boolean" },
        "localAbsolutePathsIncluded": { "type": "boolean" },
        "customerMediaIncluded": { "type": "boolean" },
        "requiredInputCount": { "type": "integer", "minimum": 0 },
        "configuredInputCount": { "type": "integer", "minimum": 0 },
        "missingOrBlockedInputCount": { "type": "integer", "minimum": 0 },
        "pendingAfterPaidRunCount": { "type": "integer", "minimum": 0 },
        "operatorInputFileCount": { "type": "integer", "minimum": 0 },
        "draftFileCount": { "type": "integer", "minimum": 0 },
        "reportArchiveFileCount": { "type": "integer", "minimum": 0 },
        "commandCount": { "type": "integer", "minimum": 0 },
        "readyCommandCount": { "type": "integer", "minimum": 0 },
        "blockedCommandCount": { "type": "integer", "minimum": 0 },
        "paidCommandCount": { "type": "integer", "minimum": 0 },
        "readyPaidCommandCount": { "type": "integer", "minimum": 0 },
        "commandPlanAuditStatus": { "type": "string" },
        "blockedInputIds": { "type": "array", "items": { "type": "string" } },
        "operatorInputFiles": { "type": "array", "items": { "type": "string" } },
        "refreshCommands": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
