{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/render-request.schema.json",
  "title": "CineJelly Render Request",
  "description": "Operator-supplied request contract for /v1/render, /v1/render-jobs, and validation:paid-render. Runtime TypeScript admission remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["userInput"],
  "properties": {
    "userInput": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24000
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": { "enum": ["mini", "fast", "standard"] },
        "resolution": { "enum": ["480p", "720p", "1080p", "720p-SR", "1080p-SR", "1440p-SR"] },
        "qualityMode": { "enum": ["economy", "standard", "high", "ultimate"] },
        "ratio": { "enum": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"] },
        "durationTargetSeconds": { "type": "number", "minimum": 15, "maximum": 480 },
        "audioMode": { "enum": ["none", "native", "guided", "post", "hybrid"] },
        "bitrateMode": { "enum": ["standard", "high"] },
        "watermark": { "type": "boolean" },
        "returnLastFrame": { "type": "boolean" },
        "maxCostUsd": { "type": "number", "minimum": 0.000001 }
      }
    },
    "modelPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seedanceModelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Optional admin-allowlisted Seedance model ID selected by UI/API clients. Runtime admission rejects IDs outside configured fast/standard/capability models."
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/reference" }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      },
      "propertyNames": {
        "type": "string",
        "maxLength": 80
      }
    },
    "outputPath": { "$ref": "#/$defs/operatorPath" },
    "workDirectory": { "$ref": "#/$defs/operatorPath" },
    "artifactDirectory": { "$ref": "#/$defs/operatorPath" },
    "captionCues": {
      "type": "array",
      "maxItems": 600,
      "items": { "$ref": "#/$defs/captionCue" }
    },
    "captionOptions": { "$ref": "#/$defs/captionOptions" },
    "audioTracks": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/audioTrack" }
    },
    "audioMixOptions": { "$ref": "#/$defs/audioMixOptions" },
    "generatedAudioIntents": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/generatedAudioIntent" }
    },
    "frameSamplingOptions": { "$ref": "#/$defs/frameSamplingOptions" },
    "transitionSettings": { "$ref": "#/$defs/transitionSettings" },
    "semanticVisualInspectionOptions": { "$ref": "#/$defs/semanticVisualInspectionOptions" },
    "sourceVideoAnalysis": { "$ref": "#/$defs/sourceVideoAnalysis" }
  },
  "$defs": {
    "operatorPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "safeHttpsOrAssetUri": {
      "type": "string",
      "pattern": "^(https://[^\\s]+|asset://[^\\s?#]+)$"
    },
    "safeHttpsUri": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "label", "providerReference", "priority"],
      "properties": {
        "role": {
          "enum": [
            "identity",
            "product",
            "wardrobe",
            "environment",
            "motion",
            "camera",
            "audio_tempo",
            "voice",
            "style",
            "first_frame",
            "last_frame",
            "source_video_structure"
          ]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "providerReference": { "$ref": "#/$defs/providerReference" },
        "priority": { "enum": ["primary", "supporting"] },
        "selection": { "$ref": "#/$defs/referenceSelection" }
      }
    },
    "providerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "first_frame",
            "last_frame",
            "identity",
            "product",
            "environment",
            "motion",
            "camera",
            "style"
          ]
        },
        "uri": { "$ref": "#/$defs/safeHttpsOrAssetUri" },
        "role": { "type": "string", "minLength": 1, "maxLength": 160 },
        "providerAssetId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "referenceSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cameraId": { "type": "string", "maxLength": 160 },
        "compositionId": { "type": "string", "maxLength": 160 },
        "characterId": { "type": "string", "maxLength": 160 },
        "view": { "enum": ["front", "side", "back", "three_quarter", "over_the_shoulder", "unknown"] },
        "timelineIndex": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "sourceShotId": { "type": "string", "maxLength": 160 },
        "sourceSceneId": { "type": "string", "maxLength": 160 },
        "authorized": { "type": "boolean" }
      }
    },
    "captionCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSecond", "endSecond", "text"],
      "properties": {
        "startSecond": { "type": "number", "minimum": 0 },
        "endSecond": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "speaker": { "type": "string", "maxLength": 120 }
      }
    },
    "captionOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "burnIn"],
      "properties": {
        "enabled": { "type": "boolean" },
        "format": { "enum": ["srt", "vtt"] },
        "burnIn": { "type": "boolean" },
        "language": { "type": "string", "maxLength": 40 },
        "font": { "type": "string", "maxLength": 120 },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 96 }
      }
    },
    "audioTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackId", "sourceUrlOrPath", "role", "volume"],
      "properties": {
        "trackId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceUrlOrPath": { "$ref": "#/$defs/safeHttpsUri" },
        "role": { "enum": ["music", "narration", "ambience", "sfx"] },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "audioMixOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "originalVolume", "outputBitrate"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["mix", "replace"] },
        "originalVolume": { "type": "number", "minimum": 0, "maximum": 2 },
        "outputBitrate": { "type": "string", "pattern": "^([1-9]\\d{1,3})k$" }
      }
    },
    "generatedAudioIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentId", "kind", "prompt"],
      "properties": {
        "intentId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["tts_narration", "bgm", "ambience", "sfx"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "startSecond": { "type": "number", "minimum": 0, "maximum": 600 },
        "endSecond": { "type": "number", "minimum": 0, "maximum": 600 },
        "durationSeconds": { "type": "number", "minimum": 0.1, "maximum": 600 },
        "language": { "type": "string", "maxLength": 160 },
        "voiceStyle": { "type": "string", "maxLength": 160 },
        "mood": { "type": "string", "maxLength": 160 },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 },
        "providerPreference": { "type": "string", "maxLength": 160 }
      }
    },
    "frameSamplingOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "outputDirectory", "intervalSeconds", "maxFrames"],
      "properties": {
        "enabled": { "type": "boolean" },
        "outputDirectory": { "type": "string", "minLength": 1, "maxLength": 512 },
        "maxFrames": { "type": "integer", "minimum": 1, "maximum": 240 },
        "intervalSeconds": { "type": "number", "minimum": 0.1, "maximum": 120 }
      }
    },
    "transitionSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "kind", "durationSeconds", "fps", "preserveAudio"],
      "properties": {
        "enabled": { "type": "boolean" },
        "kind": {
          "enum": [
            "auto",
            "fade",
            "dissolve",
            "fadeblack",
            "fadewhite",
            "hblur",
            "zoomin",
            "wipeleft",
            "wiperight",
            "wipeup",
            "wipedown",
            "slideleft",
            "slideright",
            "slideup",
            "slidedown",
            "smoothleft",
            "smoothright",
            "circleopen",
            "circleclose"
          ]
        },
        "durationSeconds": { "type": "number", "minimum": 0.001, "maximum": 3 },
        "fps": { "type": "number", "minimum": 12, "maximum": 60 },
        "targetHeight": { "enum": [480, 720, 1080, 1440] },
        "targetRatio": { "enum": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"] },
        "preserveAudio": { "type": "boolean" }
      }
    },
    "semanticVisualInspectionOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxFrames", "expectations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "maxFrames": { "type": "integer", "minimum": 1, "maximum": 60 },
        "expectations": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "sourceVideoAnalysis": {
      "type": "object",
      "description": "Bounded source-video deconstruction. Runtime admission additionally requires a matching source_video_structure reference when this object is supplied.",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["transformationIntent"] },
        {
          "required": ["transcript"],
          "properties": { "transcript": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["scenes"],
          "properties": { "scenes": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["pacingNotes"],
          "properties": { "pacingNotes": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["styleNotes"],
          "properties": { "styleNotes": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["structuralBeats"],
          "properties": { "structuralBeats": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["safetyNotes"],
          "properties": { "safetyNotes": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["mediaMetrics"]
        }
      ],
      "properties": {
        "sourceReferenceLabel": { "type": "string", "minLength": 1, "maxLength": 160 },
        "transformationIntent": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "transcript": {
          "type": "array",
          "maxItems": 1500,
          "items": { "$ref": "#/$defs/sourceVideoTranscriptCue" }
        },
        "scenes": {
          "type": "array",
          "maxItems": 160,
          "items": { "$ref": "#/$defs/sourceVideoScene" }
        },
        "pacingNotes": { "$ref": "#/$defs/sourceVideoNoteArray" },
        "styleNotes": { "$ref": "#/$defs/sourceVideoNoteArray" },
        "structuralBeats": { "$ref": "#/$defs/sourceVideoNoteArray" },
        "safetyNotes": { "$ref": "#/$defs/sourceVideoNoteArray" },
        "mediaMetrics": { "$ref": "#/$defs/sourceVideoMediaMetrics" }
      }
    },
    "sourceVideoMediaMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "audio", "editRhythm", "evidence"],
      "properties": {
        "schemaVersion": { "const": "cinejelly.source-video-media-metrics.v1" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
        "bitrate": { "type": "number", "exclusiveMinimum": 0 },
        "formatName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codecName": { "type": "string", "minLength": 1, "maxLength": 80 },
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "frameRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 240 },
            "aspectRatio": { "type": "string", "minLength": 3, "maxLength": 32 }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hasAudio"],
          "properties": {
            "hasAudio": { "type": "boolean" },
            "codecName": { "type": "string", "minLength": 1, "maxLength": 80 },
            "sampleRate": { "type": "integer", "minimum": 1, "maximum": 384000 },
            "channelCount": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        },
        "editRhythm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sceneCutCount", "rhythmLabel"],
          "properties": {
            "sampledWindowSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
            "sceneCutCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "cutDensityPerMinute": { "type": "number", "minimum": 0, "maximum": 10000 },
            "averageShotLengthSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
            "rhythmLabel": { "enum": ["unknown", "slow", "balanced", "fast", "very_fast"] },
            "sceneCutTimestampsSeconds": {
              "type": "array",
              "maxItems": 120,
              "items": { "type": "number", "minimum": 0, "maximum": 86400 }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["probeSucceeded", "sceneDetectionSucceeded", "sourceUriSha256"],
          "properties": {
            "probeSucceeded": { "type": "boolean" },
            "sceneDetectionSucceeded": { "type": "boolean" },
            "sourceUriSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          }
        }
      }
    },
    "sourceVideoTranscriptCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSecond", "endSecond", "text"],
      "properties": {
        "startSecond": { "type": "number", "minimum": 0 },
        "endSecond": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "sourceVideoScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneId", "startSecond", "endSecond", "summary"],
      "properties": {
        "sceneId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "startSecond": { "type": "number", "minimum": 0 },
        "endSecond": { "type": "number", "minimum": 0 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "pacing": { "type": "string", "maxLength": 2000 },
        "camera": { "type": "string", "maxLength": 2000 },
        "audio": { "type": "string", "maxLength": 2000 },
        "visualStyle": { "type": "string", "maxLength": 2000 },
        "keyframes": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/sourceVideoKeyframe" }
        }
      }
    },
    "sourceVideoKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestampSecond", "description"],
      "properties": {
        "timestampSecond": { "type": "number", "minimum": 0 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "uri": { "$ref": "#/$defs/safeHttpsOrAssetUri" }
      }
    },
    "sourceVideoNoteArray": {
      "type": "array",
      "maxItems": 120,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
