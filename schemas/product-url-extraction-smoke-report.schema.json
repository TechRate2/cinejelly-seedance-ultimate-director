{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/product-url-extraction-smoke-report.schema.json",
  "title": "CineJelly Product URL Extraction Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "liveProductFetchMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "scenarios",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.product-url-extraction-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "liveProductFetchMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputPath",
        "scenarioCount",
        "endpointPath",
        "rawUrlLeakCheckPassed",
        "simulatedFetchCallCount"
      ],
      "properties": {
        "outputPath": { "type": "string" },
        "scenarioCount": { "const": 3 },
        "endpointPath": { "const": "/v1/short-pipeline/product-url-plan" },
        "rawUrlLeakCheckPassed": { "const": true },
        "simulatedFetchCallCount": { "type": "integer", "minimum": 1, "maximum": 1 }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanExtraction", "noConfirmation", "unsafeUrlBlocked"],
      "properties": {
        "cleanExtraction": { "$ref": "#/$defs/cleanExtractionScenario" },
        "noConfirmation": { "$ref": "#/$defs/blockedScenario" },
        "unsafeUrlBlocked": { "$ref": "#/$defs/blockedScenario" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productUrlExtractionSmokePass",
        "canUseAsProductUrlToVideoBackendEvidence",
        "canUseAsBusinessReadinessProductUrlEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "productUrlExtractionSmokePass": { "type": "boolean" },
        "canUseAsProductUrlToVideoBackendEvidence": { "type": "boolean" },
        "canUseAsBusinessReadinessProductUrlEvidence": { "const": false },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "cleanExtractionScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researchStatus",
        "fetchAttempted",
        "simulatedFetchCallCount",
        "sourceStatus",
        "sourceHostPresent",
        "sourceUrlSha256Present",
        "titlePresent",
        "descriptionPresent",
        "benefitCount",
        "claimCount",
        "imageCount",
        "pricePresent",
        "planStatus",
        "planSceneCount",
        "productBriefStatus",
        "claimCheckpointCount",
        "canUseAsProductUrlToVideoBackendEvidence",
        "canReleaseToCustomerTraffic"
      ],
      "properties": {
        "researchStatus": { "const": "ready" },
        "fetchAttempted": { "const": true },
        "simulatedFetchCallCount": { "const": 1 },
        "sourceStatus": { "const": "clean_https" },
        "sourceHostPresent": { "type": "boolean" },
        "sourceUrlSha256Present": { "type": "boolean" },
        "titlePresent": { "type": "boolean" },
        "descriptionPresent": { "type": "boolean" },
        "benefitCount": { "type": "integer", "minimum": 1 },
        "claimCount": { "type": "integer", "minimum": 1 },
        "imageCount": { "type": "integer", "minimum": 1 },
        "pricePresent": { "type": "boolean" },
        "planStatus": { "enum": ["approval_required", "changes_requested", "blocked"] },
        "planSceneCount": { "type": "integer", "minimum": 1 },
        "productBriefStatus": { "type": "string" },
        "claimCheckpointCount": { "type": "integer", "minimum": 1 },
        "canUseAsProductUrlToVideoBackendEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false }
      }
    },
    "blockedScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researchStatus",
        "fetchAttempted",
        "simulatedFetchCallCount",
        "sourceStatus",
        "sourceUrlSha256Present",
        "issueCount",
        "canUseAsProductUrlToVideoBackendEvidence",
        "canReleaseToCustomerTraffic"
      ],
      "properties": {
        "researchStatus": {
          "enum": [
            "blocked_by_live_network_confirmation",
            "blocked_by_unsafe_url",
            "fetch_failed",
            "unsupported_content_type",
            "response_too_large",
            "extraction_empty"
          ]
        },
        "fetchAttempted": { "const": false },
        "simulatedFetchCallCount": { "type": "integer", "minimum": 1, "maximum": 1 },
        "sourceStatus": { "type": "string" },
        "sourceUrlSha256Present": { "type": "boolean" },
        "issueCount": { "type": "integer", "minimum": 1 },
        "canUseAsProductUrlToVideoBackendEvidence": { "const": false },
        "canReleaseToCustomerTraffic": { "const": false }
      }
    }
  }
}
