{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/remote-stock-adapter-smoke-report.schema.json",
  "title": "CineJelly Remote Stock Adapter Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "summary",
    "scenarioSummaries",
    "materialValidation",
    "candidateSummaries",
    "candidateEvaluations",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.remote-stock-adapter-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputPath",
        "syntheticProviderCount",
        "syntheticScenarioCount",
        "syntheticBriefCount",
        "syntheticCandidateCount"
      ],
      "properties": {
        "outputPath": { "type": "string" },
        "syntheticProviderCount": { "type": "integer", "minimum": 1 },
        "syntheticScenarioCount": { "type": "integer", "minimum": 1 },
        "syntheticBriefCount": { "type": "integer", "minimum": 1 },
        "syntheticCandidateCount": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioCount",
        "passingScenarioCount",
        "failingScenarioCount",
        "syntheticFetchCallCount",
        "generatedCandidateCount",
        "aggregateMaterialValidationStatus",
        "aggregateApprovedCandidateCount"
      ],
      "properties": {
        "scenarioCount": { "type": "integer", "minimum": 0 },
        "passingScenarioCount": { "type": "integer", "minimum": 0 },
        "failingScenarioCount": { "type": "integer", "minimum": 0 },
        "syntheticFetchCallCount": { "type": "integer", "minimum": 0 },
        "generatedCandidateCount": { "type": "integer", "minimum": 0 },
        "aggregateMaterialValidationStatus": { "enum": ["planned_only", "approved", "review_required", "rejected"] },
        "aggregateApprovedCandidateCount": { "type": "integer", "minimum": 0 }
      }
    },
    "scenarioSummaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenarioSummary" }
    },
    "materialValidation": { "$ref": "#/$defs/materialValidation" },
    "candidateSummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateSummary" }
    },
    "candidateEvaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateEvaluation" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canUseAsRemoteStockAdapterBackendEvidence",
        "canUseAsLiveRemoteStockEvidence",
        "canOpenPaidCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "canUseAsRemoteStockAdapterBackendEvidence": { "type": "boolean" },
        "canUseAsLiveRemoteStockEvidence": { "const": false },
        "canOpenPaidCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "scenarioSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "intent",
        "provider",
        "syntheticFetchCallCount",
        "candidateCount",
        "materialValidationStatus",
        "approvedCandidateCount",
        "rejectedCandidateCount",
        "onlyCredentialFreeHttpsCandidates",
        "noCredentialMaterialized",
        "candidateCountWithinBounds",
        "attributionPreserved",
        "outboundCredentialUsedOnlyForSearch",
        "materialValidatorAccepted"
      ],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["pass", "fail"] },
        "intent": { "type": "string" },
        "provider": { "enum": ["pexels", "pixabay", "coverr"] },
        "syntheticFetchCallCount": { "type": "integer", "minimum": 0 },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "materialValidationStatus": { "enum": ["planned_only", "approved", "review_required", "rejected"] },
        "approvedCandidateCount": { "type": "integer", "minimum": 0 },
        "rejectedCandidateCount": { "type": "integer", "minimum": 0 },
        "onlyCredentialFreeHttpsCandidates": { "type": "boolean" },
        "noCredentialMaterialized": { "type": "boolean" },
        "candidateCountWithinBounds": { "type": "boolean" },
        "attributionPreserved": { "type": "boolean" },
        "outboundCredentialUsedOnlyForSearch": { "type": "boolean" },
        "materialValidatorAccepted": { "type": "boolean" },
        "providerSearchSkipped": { "type": "boolean" },
        "authorizationHeaderObserved": { "type": "boolean" },
        "searchUrlKeyQueryObserved": { "type": "boolean" },
        "unsafeRenditionSkipped": { "type": "boolean" },
        "shortDurationSkipped": { "type": "boolean" },
        "providerFailureHandled": { "type": "boolean" },
        "coverrCommercialApprovalRequired": { "type": "boolean" },
        "thrownErrorRedacted": { "type": "string" },
        "candidateSummaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidateSummary" }
        }
      }
    },
    "materialValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "planId",
        "projectId",
        "candidateCount",
        "selectedCandidateCount",
        "approvedCandidateCount",
        "rejectedCandidateCount",
        "candidateEvaluationCount",
        "decisionCounts",
        "issueCounts",
        "issueCodeCounts",
        "minFitScore",
        "maxFitScore"
      ],
      "properties": {
        "status": { "enum": ["planned_only", "approved", "review_required", "rejected"] },
        "planId": { "type": "string" },
        "projectId": { "type": "string" },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "selectedCandidateCount": { "type": "integer", "minimum": 0 },
        "approvedCandidateCount": { "type": "integer", "minimum": 0 },
        "rejectedCandidateCount": { "type": "integer", "minimum": 0 },
        "candidateEvaluationCount": { "type": "integer", "minimum": 0 },
        "decisionCounts": { "$ref": "#/$defs/counts" },
        "issueCounts": { "$ref": "#/$defs/counts" },
        "issueCodeCounts": { "$ref": "#/$defs/counts" },
        "minFitScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxFitScore": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "candidateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "briefId",
        "source",
        "providerAssetId",
        "uriFingerprint",
        "sourcePageUrlPresent",
        "previewUriPresent",
        "licenseLabelPresent",
        "durationSeconds",
        "aspectRatio",
        "resolution",
        "rightsStatus",
        "attributionPresent",
        "selected"
      ],
      "properties": {
        "candidateId": { "type": "string" },
        "briefId": { "type": "string" },
        "source": { "enum": ["pexels", "pixabay", "coverr"] },
        "providerAssetId": { "type": "string" },
        "uriFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourcePageUrlPresent": { "type": "boolean" },
        "previewUriPresent": { "type": "boolean" },
        "licenseLabelPresent": { "type": "boolean" },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "aspectRatio": { "type": "string" },
        "resolution": { "type": "string" },
        "rightsStatus": { "enum": ["unverified", "approved", "requires_attribution", "rejected"] },
        "attributionPresent": { "type": "boolean" },
        "selected": { "type": "boolean" }
      }
    },
    "candidateEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "briefId",
        "source",
        "selected",
        "decision",
        "fitScore",
        "maxFitScore",
        "scoreFactors",
        "blockingIssueCodes",
        "warningIssueCodes",
        "recommendedAction"
      ],
      "properties": {
        "candidateId": { "type": "string" },
        "briefId": { "type": "string" },
        "source": { "enum": ["user_provided", "local_library", "pexels", "pixabay", "coverr", "paid_stock", "atlas_asset_library"] },
        "selected": { "type": "boolean" },
        "decision": { "enum": ["approved", "review_required", "rejected"] },
        "fitScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxFitScore": { "const": 100 },
        "scoreFactors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "score", "maxScore", "passed", "message"],
            "properties": {
              "name": { "type": "string" },
              "score": { "type": "number", "minimum": 0 },
              "maxScore": { "type": "number", "minimum": 0 },
              "passed": { "type": "boolean" },
              "message": { "type": "string" }
            }
          }
        },
        "blockingIssueCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warningIssueCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendedAction": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["pass", "fail"] },
        "message": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
