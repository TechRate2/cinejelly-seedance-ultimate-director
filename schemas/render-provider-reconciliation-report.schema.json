{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/render-provider-reconciliation-report.schema.json",
  "title": "CineJelly Render Provider Reconciliation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "summary",
    "jobs",
    "releaseGateSummary",
    "nextActions",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.render-provider-reconciliation.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "warn", "fail"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedJobCount",
        "checkpointJobCount",
        "activePredictionIdCount",
        "queriedPredictionCount",
        "terminalPredictionCount",
        "stillActivePredictionCount",
        "providerUnavailableCount",
        "queryFailureCount",
        "skippedJobCount"
      ],
      "properties": {
        "checkedJobCount": { "type": "integer", "minimum": 0 },
        "checkpointJobCount": { "type": "integer", "minimum": 0 },
        "activePredictionIdCount": { "type": "integer", "minimum": 0 },
        "queriedPredictionCount": { "type": "integer", "minimum": 0 },
        "terminalPredictionCount": { "type": "integer", "minimum": 0 },
        "stillActivePredictionCount": { "type": "integer", "minimum": 0 },
        "providerUnavailableCount": { "type": "integer", "minimum": 0 },
        "queryFailureCount": { "type": "integer", "minimum": 0 },
        "skippedJobCount": { "type": "integer", "minimum": 0 }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "jobStatus",
          "checkpointPresent",
          "activePredictionIds",
          "terminalPredictionIds",
          "decision",
          "status",
          "predictions"
        ],
        "properties": {
          "jobId": { "type": "string", "minLength": 1 },
          "jobStatus": { "enum": ["queued", "running", "succeeded", "failed", "canceled"] },
          "retentionSource": { "enum": ["memory", "history_store"] },
          "detailRetention": { "enum": ["full", "compact_restored"] },
          "checkpointPresent": { "type": "boolean" },
          "providerName": { "type": "string" },
          "providerOperationCount": { "type": "integer", "minimum": 0 },
          "activePredictionIds": { "type": "array", "items": { "type": "string" } },
          "terminalPredictionIds": { "type": "array", "items": { "type": "string" } },
          "latestProviderStatus": { "type": "string" },
          "decision": {
            "enum": [
              "no_checkpoint",
              "no_active_provider_work",
              "provider_unavailable",
              "query_failed",
              "still_active",
              "terminal_succeeded",
              "terminal_failed",
              "terminal_canceled",
              "terminal_timeout",
              "mixed"
            ]
          },
          "status": { "enum": ["pass", "warn", "fail", "skipped"] },
          "predictions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "predictionId",
                "status",
                "decision",
                "checkedAt",
                "terminal"
              ],
              "properties": {
                "provider": { "type": "string" },
                "predictionId": { "type": "string" },
                "status": { "enum": ["pass", "warn", "fail"] },
                "decision": {
                  "enum": [
                    "provider_unavailable",
                    "query_failed",
                    "still_active",
                    "terminal_succeeded",
                    "terminal_failed",
                    "terminal_canceled",
                    "terminal_timeout"
                  ]
                },
                "checkedAt": { "type": "string", "format": "date-time" },
                "providerStatus": {
                  "enum": ["queued", "running", "succeeded", "failed", "canceled", "timeout"]
                },
                "terminal": { "type": "boolean" },
                "outputUrlCount": { "type": "integer", "minimum": 0 },
                "error": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerStateReconciliationPass",
        "activeProviderWorkResolved",
        "canClaimDistributedResume",
        "releaseBlocker"
      ],
      "properties": {
        "providerStateReconciliationPass": { "type": "boolean" },
        "activeProviderWorkResolved": { "type": "boolean" },
        "canClaimDistributedResume": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "string" } },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": { "type": "array", "items": { "type": "string" } },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "fakeProvider", "jobCount", "providerCount"],
      "properties": {
        "outputPath": { "type": "string" },
        "fakeProvider": { "type": "boolean" },
        "jobCount": { "type": "integer", "minimum": 0 },
        "providerCount": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
