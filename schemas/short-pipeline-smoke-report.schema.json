{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/short-pipeline-smoke-report.schema.json",
  "title": "CineJelly Short Pipeline Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "scenarios",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.short-pipeline-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "scenarioCount", "endpointPath", "renderHandoffEndpointPath", "rawUrlLeakCheckPassed"],
      "properties": {
        "outputPath": { "type": "string" },
        "scenarioCount": { "const": 3 },
        "endpointPath": { "const": "/v1/short-pipeline/plan" },
        "renderHandoffEndpointPath": { "const": "/v1/short-pipeline/render-jobs" },
        "rawUrlLeakCheckPassed": { "type": "boolean" }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewRequired", "blocked", "naturalOnly", "renderHandoff"],
      "properties": {
        "reviewRequired": { "$ref": "#/$defs/scenario" },
        "blocked": { "$ref": "#/$defs/scenario" },
        "naturalOnly": { "$ref": "#/$defs/scenario" },
        "renderHandoff": { "$ref": "#/$defs/renderHandoffScenario" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortPipelineSmokePass",
        "canUseAsNoSpendBackendEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "shortPipelineSmokePass": { "type": "boolean" },
        "canUseAsNoSpendBackendEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "status",
        "templatePolicy",
        "dynamicWorkflowRequired",
        "templateSuggestionCount",
        "sceneCount",
        "reviewApprovalStatus",
        "reviewCheckpointCount",
        "reviewIssueCount",
        "productSourceUrlSha256Present",
        "productRawUrlSerialized",
        "brandIssueCodes",
        "commercialReadinessStatus",
        "commercialReadinessScore",
        "crawlerPolicyStatus",
        "referenceAnalysisStatus",
        "outcomeMemoryStatus",
        "readinessCheckCount",
        "channelStyleAnchorCount",
        "channelStyleMemoryPatternCount",
        "canUseAsNoSpendPlanningEvidence",
        "canReleaseToCustomerTraffic"
      ],
      "properties": {
        "planId": { "type": "string" },
        "status": { "enum": ["approval_required", "changes_requested", "blocked"] },
        "templatePolicy": { "enum": ["none", "suggested_optional", "operator_selected_optional"] },
        "dynamicWorkflowRequired": { "const": true },
        "templateSuggestionCount": { "type": "integer", "minimum": 0 },
        "sceneCount": { "type": "integer", "minimum": 1 },
        "reviewApprovalStatus": { "type": "string" },
        "reviewCheckpointCount": { "type": "integer", "minimum": 1 },
        "reviewIssueCount": { "type": "integer", "minimum": 0 },
        "productBriefStatus": { "type": "string" },
        "productSourceStatus": { "type": "string" },
        "productSourceUrlSha256Present": { "type": "boolean" },
        "productRawUrlSerialized": { "const": false },
        "brandKitStatus": { "type": "string" },
        "brandIssueCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "commercialReadinessStatus": { "enum": ["ready", "review_required", "blocked"] },
        "commercialReadinessScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "crawlerPolicyStatus": {
          "enum": ["not_needed", "snapshot_ready", "live_crawl_optional", "clean_url_required", "blocked_by_unsafe_url"]
        },
        "referenceAnalysisStatus": {
          "enum": ["not_provided", "operator_summary_ready", "auto_analysis_recommended", "review_required", "blocked"]
        },
        "outcomeMemoryStatus": {
          "enum": ["ready_to_write_after_review", "waiting_for_persistent_store", "blocked"]
        },
        "readinessCheckCount": { "type": "integer", "minimum": 10 },
        "channelStyleProfileStatus": { "enum": ["ready", "review_required", "blocked"] },
        "channelStyleAnchorCount": { "type": "integer", "minimum": 0 },
        "channelStyleMemoryPatternCount": { "type": "integer", "minimum": 0 },
        "canUseAsNoSpendPlanningEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false }
      }
    },
    "renderHandoffScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "pendingReviewCanQueueRender",
        "approvedReviewCanQueueRender",
        "canUseAsRenderJobHandoff",
        "captionCueCount",
        "generatedAudioIntentCount",
        "requestHasPlanLineage",
        "requestHasWorkspaceLineage",
        "requestHasCommercialReadinessLineage",
        "commercialReadinessStatus",
        "crawlerPolicyStatus",
        "outcomeMemoryStatus",
        "requestHasChannelStyleLineage",
        "requestDurationSeconds",
        "requestAspectRatio",
        "requestRawUrlSerialized",
        "canReleaseToCustomerTraffic"
      ],
      "properties": {
        "planId": { "type": "string" },
        "pendingReviewCanQueueRender": { "const": false },
        "approvedReviewCanQueueRender": { "const": true },
        "canUseAsRenderJobHandoff": { "type": "boolean" },
        "captionCueCount": { "type": "integer", "minimum": 1 },
        "generatedAudioIntentCount": { "type": "integer", "minimum": 1 },
        "requestHasPlanLineage": { "type": "boolean" },
        "requestHasWorkspaceLineage": { "type": "boolean" },
        "requestHasCommercialReadinessLineage": { "type": "boolean" },
        "commercialReadinessStatus": { "type": "string" },
        "crawlerPolicyStatus": { "type": "string" },
        "outcomeMemoryStatus": { "type": "string" },
        "requestHasChannelStyleLineage": { "type": "boolean" },
        "requestDurationSeconds": { "type": "number", "minimum": 1 },
        "requestAspectRatio": { "type": "string" },
        "requestRawUrlSerialized": { "const": false },
        "canReleaseToCustomerTraffic": { "const": false }
      }
    }
  }
}
