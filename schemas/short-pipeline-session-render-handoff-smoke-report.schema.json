{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/short-pipeline-session-render-handoff-smoke-report.schema.json",
  "title": "CineJelly Short Pipeline Session Render Handoff Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "localHttpCallsMade",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "scenarios",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.short-pipeline-session-render-handoff-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "localHttpCallsMade": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputPath",
        "storePath",
        "endpointPaths",
        "sessionId",
        "visualBibleSessionId",
        "pendingJobId",
        "unsafeReviewJobId",
        "approvedWithoutConfirmStatusCode",
        "planInputOverrideStatusCode",
        "visualBibleSessionRenderStatusCode",
        "visualBibleDirectRenderStatusCode",
        "clientIsolationCheckPassed",
        "rawUrlLeakCheckPassed",
        "localPathLeakCheckPassed",
        "spendReservationCreated"
      ],
      "properties": {
        "outputPath": { "type": "string" },
        "storePath": { "type": "string" },
        "endpointPaths": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "sessionId": { "type": "string", "pattern": "^short_session_[a-f0-9]{16}$" },
        "visualBibleSessionId": { "type": "string", "pattern": "^short_session_[a-f0-9]{16}$" },
        "pendingJobId": { "type": "string", "pattern": "^render_job_[0-9a-fA-F-]{36}$" },
        "unsafeReviewJobId": { "type": "string", "pattern": "^render_job_[0-9a-fA-F-]{36}$" },
        "approvedWithoutConfirmStatusCode": { "const": 422 },
        "planInputOverrideStatusCode": { "const": 400 },
        "visualBibleSessionRenderStatusCode": { "const": 422 },
        "visualBibleDirectRenderStatusCode": { "const": 422 },
        "clientIsolationCheckPassed": { "const": true },
        "rawUrlLeakCheckPassed": { "const": true },
        "localPathLeakCheckPassed": { "const": true },
        "spendReservationCreated": { "const": false }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pendingSessionRender",
        "approvedWithoutConfirmation",
        "planInputOverride",
        "unsafeApprovedReview",
        "visualBibleAssetGate",
        "clientIsolation"
      ],
      "properties": {
        "pendingSessionRender": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "jobStatus",
            "reviewApprovalStatus",
            "queuedForProviderSpend",
            "hasReservation"
          ],
          "properties": {
            "statusCode": { "const": 202 },
            "jobStatus": { "const": "paused_for_review" },
            "reviewApprovalStatus": { "const": "approval_required" },
            "queuedForProviderSpend": { "const": false },
            "hasReservation": { "const": false }
          }
        },
        "approvedWithoutConfirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statusCode", "blockedBeforeJobCreation"],
          "properties": {
            "statusCode": { "const": 422 },
            "blockedBeforeJobCreation": { "const": true }
          }
        },
        "planInputOverride": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statusCode", "blockedBeforeJobCreation"],
          "properties": {
            "statusCode": { "const": 400 },
            "blockedBeforeJobCreation": { "const": true }
          }
        },
        "unsafeApprovedReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statusCode", "jobStatus", "reviewApprovalStatus", "hasReservation"],
          "properties": {
            "statusCode": { "const": 202 },
            "jobStatus": { "const": "blocked" },
            "reviewApprovalStatus": { "const": "blocked" },
            "hasReservation": { "const": false }
          }
        },
        "visualBibleAssetGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionCreateStatusCode",
            "sessionRenderStatusCode",
            "directRenderStatusCode",
            "sessionBlockedBeforeJobCreation",
            "directBlockedBeforeJobCreation"
          ],
          "properties": {
            "sessionCreateStatusCode": { "const": 201 },
            "sessionRenderStatusCode": { "const": 422 },
            "directRenderStatusCode": { "const": 422 },
            "sessionBlockedBeforeJobCreation": { "const": true },
            "directBlockedBeforeJobCreation": { "const": true }
          }
        },
        "clientIsolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clientBStatusCode", "ownerVisibleJobCount"],
          "properties": {
            "clientBStatusCode": { "const": 404 },
            "ownerVisibleJobCount": { "type": "integer", "minimum": 2 }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortPipelineSessionRenderHandoffSmokePass",
        "canUseAsNoSpendBackendEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "shortPipelineSessionRenderHandoffSmokePass": { "type": "boolean" },
        "canUseAsNoSpendBackendEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
