{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/generated-audio-manual-review.schema.json",
  "title": "CineJelly Generated Audio Manual Review Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewerType",
    "status",
    "decision",
    "reviewedAt",
    "reviewerId",
    "sourceGeneratedAudioReportPath",
    "artifactBinding",
    "artifactEvidence",
    "checks",
    "findings",
    "redactionReviewed"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.generated-audio-manual-review.v1" },
    "reviewerType": { "enum": ["manual", "approved_analyzer"] },
    "status": { "const": "accepted" },
    "decision": { "const": "pass" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewerId": { "type": "string", "minLength": 3, "maxLength": 120 },
    "sourceGeneratedAudioReportPath": { "$ref": "#/$defs/repoPath" },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "language",
        "voiceId",
        "outputFormat",
        "intentId",
        "providerAssetId",
        "predictionId",
        "outputUrlPreview"
      ],
      "properties": {
        "modelId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "language": { "type": "string", "minLength": 2, "maxLength": 20 },
        "voiceId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "outputFormat": { "enum": ["mp3", "wav"] },
        "intentId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "providerAssetId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "predictionId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "outputUrlPreview": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^?#]+$",
          "maxLength": 600
        }
      }
    },
    "artifactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAudioArtifactEvidenceReportPath",
        "artifactPath",
        "mediaSha256",
        "byteSize",
        "durationSeconds",
        "outputUrlPreview",
        "predictionId"
      ],
      "properties": {
        "generatedAudioArtifactEvidenceReportPath": { "$ref": "#/$defs/repoPath" },
        "artifactPath": { "$ref": "#/$defs/repoPath" },
        "mediaSha256": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "outputUrlPreview": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^?#]+$",
          "maxLength": 600
        },
        "predictionId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listenedFullOutput",
        "outputIsAudible",
        "languageMatchesRequest",
        "narrationMatchesValidationText",
        "noObviousArtifacts",
        "noCredentialLeak",
        "safeForBusinessEvidence"
      ],
      "properties": {
        "listenedFullOutput": { "const": true },
        "outputIsAudible": { "const": true },
        "languageMatchesRequest": { "const": true },
        "narrationMatchesValidationText": { "const": true },
        "noObviousArtifacts": { "const": true },
        "noCredentialLeak": { "const": true },
        "safeForBusinessEvidence": { "const": true }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 3, "maxLength": 1000 }
    },
    "redactionReviewed": { "const": true }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^[^:\\\\]+(?:[\\\\/][^:\\\\]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
