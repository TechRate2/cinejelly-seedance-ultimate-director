{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/render-provider-live-action-evidence.schema.json",
  "title": "CineJelly Render Provider Live Action Evidence Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environmentKind",
    "deploymentBaseUrl",
    "approvedBy",
    "approvedAt",
    "executions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.render-provider-live-action-evidence.v1" },
    "environmentKind": { "const": "deployment" },
    "deploymentBaseUrl": { "type": "string", "format": "uri" },
    "approvedBy": { "$ref": "#/$defs/safeEvidenceText" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/execution" }
    }
  },
  "$defs": {
    "safeEvidenceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {
        "anyOf": [
          { "pattern": "replace[-_\\s]?with|placeholder|\\btodo\\b|\\btbd\\b" },
          { "pattern": "Bearer\\s+[A-Za-z0-9._-]+" },
          { "pattern": "sk-[A-Za-z0-9_-]+" },
          { "pattern": "(api[_-]?key|access[_-]?key|token|secret|password|signature|credential|authorization)\\s*[:=]\\s*[\\\"']?[^\\\"',\\s&]+" },
          { "pattern": "([?&](?:api[_-]?key|access[_-]?key|token|secret|password|signature|credential|authorization)=)[^&#\\s]+" },
          { "pattern": "[A-Za-z]:\\\\[^\\s\\\"'<>]+" },
          { "pattern": "\\/(?:home|Users|var|tmp)\\/[^\\s\\\"'<>]+" },
          { "pattern": "https?:\\/\\/[^\\s\\\"'<>]+" },
          { "pattern": "(?:file|s3|gs|ftp):\\/\\/[^\\s\\\"'<>]+" },
          { "pattern": "data:[^\\s\\\"'<>]+" }
        ]
      }
    },
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "not": {
        "anyOf": [
          { "pattern": "replace[-_\\s]?with|placeholder|\\btodo\\b|\\btbd\\b" },
          { "pattern": "Bearer\\s+[A-Za-z0-9._-]+" },
          { "pattern": "sk-[A-Za-z0-9_-]+" },
          { "pattern": "(api[_-]?key|access[_-]?key|token|secret|password|signature|credential|authorization)\\s*[:=]\\s*[\\\"']?[^\\\"',\\s&]+" },
          { "pattern": "([?&](?:api[_-]?key|access[_-]?key|token|secret|password|signature|credential|authorization)=)[^&#\\s]+" },
          { "pattern": "[A-Za-z]:\\\\[^\\s\\\"'<>]+" },
          { "pattern": "\\/(?:home|Users|var|tmp)\\/[^\\s\\\"'<>]+" },
          { "pattern": "https?:\\/\\/[^\\s\\\"'<>]+" },
          { "pattern": "(?:file|s3|gs|ftp):\\/\\/[^\\s\\\"'<>]+" },
          { "pattern": "data:[^\\s\\\"'<>]+" }
        ]
      }
    },
    "workerAction": {
      "enum": [
        "resume_polling",
        "close_terminal_succeeded",
        "close_terminal_failed",
        "close_terminal_canceled",
        "close_terminal_timeout",
        "close_terminal_mixed",
        "manual_audit_required"
      ]
    },
    "providerCallKind": {
      "enum": [
        "prediction_poll",
        "terminal_closeout",
        "manual_audit_enqueue",
        "provider_cancel_or_close",
        "graph_resume_enqueue"
      ]
    },
    "resultStatus": {
      "enum": [
        "succeeded",
        "still_active",
        "terminal_failed",
        "manual_audit_queued",
        "resume_enqueued",
        "closeout_recorded"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "jobId",
        "action",
        "predictionIds",
        "provider",
        "providerCallKind",
        "providerCallMade",
        "resultStatus",
        "executedAt",
        "evidenceSummary",
        "redactionReviewed",
        "rawProviderPayloadStored",
        "outputUrlsStored"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "resume_polling" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "providerCallKind": { "enum": ["prediction_poll", "graph_resume_enqueue"] },
              "resultStatus": { "enum": ["still_active", "resume_enqueued"] }
            }
          }
        },
        {
          "if": {
            "properties": { "providerCallKind": { "const": "graph_resume_enqueue" } },
            "required": ["providerCallKind"]
          },
          "then": {
            "properties": {
              "action": { "const": "resume_polling" },
              "resultStatus": { "const": "resume_enqueued" }
            }
          }
        },
        {
          "if": {
            "properties": { "resultStatus": { "const": "resume_enqueued" } },
            "required": ["resultStatus"]
          },
          "then": {
            "properties": {
              "action": { "const": "resume_polling" },
              "providerCallKind": { "const": "graph_resume_enqueue" }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "enum": ["close_terminal_succeeded", "close_terminal_failed", "close_terminal_canceled", "close_terminal_timeout", "close_terminal_mixed"] } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "providerCallKind": { "enum": ["terminal_closeout", "provider_cancel_or_close"] },
              "resultStatus": { "enum": ["succeeded", "terminal_failed", "closeout_recorded"] }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "manual_audit_required" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "providerCallKind": { "const": "manual_audit_enqueue" },
              "resultStatus": { "const": "manual_audit_queued" }
            }
          }
        }
      ],
      "properties": {
        "actionId": { "$ref": "#/$defs/safeIdentifier" },
        "jobId": { "$ref": "#/$defs/safeIdentifier" },
        "action": { "$ref": "#/$defs/workerAction" },
        "predictionIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/safeIdentifier" }
        },
        "provider": { "$ref": "#/$defs/safeIdentifier" },
        "providerCallKind": { "$ref": "#/$defs/providerCallKind" },
        "providerCallMade": { "const": true },
        "resultStatus": { "$ref": "#/$defs/resultStatus" },
        "executedAt": { "type": "string", "format": "date-time" },
        "evidenceSummary": { "$ref": "#/$defs/safeEvidenceText" },
        "redactionReviewed": { "const": true },
        "rawProviderPayloadStored": { "const": false },
        "outputUrlsStored": { "const": false }
      }
    }
  }
}
