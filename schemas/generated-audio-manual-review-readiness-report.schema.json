{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/generated-audio-manual-review-readiness-report.schema.json",
  "title": "CineJelly Generated Audio Manual Review Readiness Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "releaseEvidence",
    "sourcePatternOrigins",
    "checkedInputs",
    "sourceReportContext",
    "artifactEvidenceContext",
    "manualReviewContext",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.generated-audio-manual-review-readiness.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "accepted_manual_review",
        "ready_for_manual_review",
        "blocked_by_generated_audio_report",
        "blocked_by_artifact_evidence",
        "blocked_by_manual_review"
      ]
    },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "releaseEvidence": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAudioReportPath",
        "artifactEvidenceReportPath",
        "manualAudioReviewPath",
        "outputPath"
      ],
      "properties": {
        "generatedAudioReportPath": { "$ref": "#/$defs/repoPath" },
        "artifactEvidenceReportPath": { "$ref": "#/$defs/repoPath" },
        "manualAudioReviewPath": { "$ref": "#/$defs/repoPath" },
        "outputPath": { "$ref": "#/$defs/repoPath" }
      }
    },
    "sourceReportContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportPresent",
        "reportPath",
        "schemaVersion",
        "status",
        "providerSpendEvidence",
        "atlasBillingEvidence",
        "schemaReviewEvidence",
        "providerExecutionSucceeded",
        "outputBatchApproved",
        "approvedTrackCount",
        "providerLedgerEntryCount",
        "outputUrlClean",
        "readyForArtifactAndManualReview",
        "artifactBinding"
      ],
      "properties": {
        "reportPresent": { "type": "boolean" },
        "reportPath": { "$ref": "#/$defs/repoPath" },
        "schemaVersion": { "type": "string" },
        "status": { "type": "string" },
        "providerSpendEvidence": { "type": "boolean" },
        "atlasBillingEvidence": { "type": "boolean" },
        "schemaReviewEvidence": { "type": "boolean" },
        "providerExecutionSucceeded": { "type": "boolean" },
        "outputBatchApproved": { "type": "boolean" },
        "approvedTrackCount": { "type": "integer", "minimum": 0 },
        "providerLedgerEntryCount": { "type": "integer", "minimum": 0 },
        "outputUrlClean": { "type": "boolean" },
        "readyForArtifactAndManualReview": { "type": "boolean" },
        "outputUrlSha256": { "$ref": "#/$defs/sha256" },
        "artifactBinding": { "$ref": "#/$defs/safeBinding" }
      }
    },
    "artifactEvidenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportPresent",
        "reportPath",
        "schemaVersion",
        "status",
        "canUseAsManualReviewArtifactEvidence",
        "bindingMatchesSourceReport",
        "readyForManualReviewBinding"
      ],
      "properties": {
        "reportPresent": { "type": "boolean" },
        "reportPath": { "$ref": "#/$defs/repoPath" },
        "schemaVersion": { "type": "string" },
        "status": { "type": "string" },
        "canUseAsManualReviewArtifactEvidence": { "type": "boolean" },
        "bindingMatchesSourceReport": { "type": "boolean" },
        "readyForManualReviewBinding": { "type": "boolean" },
        "mediaSha256": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "outputUrlSha256": { "$ref": "#/$defs/sha256" },
        "predictionId": { "type": "string", "minLength": 1 },
        "artifactPath": { "$ref": "#/$defs/repoPath" }
      }
    },
    "manualReviewContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "path",
        "passed",
        "status",
        "decision",
        "requiredCheckCount",
        "passedCheckCount",
        "artifactBindingMatchesReport",
        "artifactEvidenceMatchesReport",
        "message"
      ],
      "properties": {
        "present": { "type": "boolean" },
        "path": { "$ref": "#/$defs/repoPath" },
        "passed": { "type": "boolean" },
        "schemaVersion": { "type": "string" },
        "reviewerType": { "type": "string" },
        "status": { "type": "string" },
        "decision": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "requiredCheckCount": { "type": "integer", "minimum": 1 },
        "passedCheckCount": { "type": "integer", "minimum": 0 },
        "artifactBindingMatchesReport": { "type": "boolean" },
        "artifactEvidenceMatchesReport": { "type": "boolean" },
        "artifactEvidenceReportPath": { "$ref": "#/$defs/repoPath" },
        "mediaSha256": { "$ref": "#/$defs/sha256" },
        "templateFieldsPresent": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/check" }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canUseAsManualReviewReadinessEvidence",
        "canUseManualReviewAsGeneratedAudioEvidence",
        "canUseAsBusinessReadinessGeneratedAudioEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "canUseAsManualReviewReadinessEvidence": { "type": "boolean" },
        "canUseManualReviewAsGeneratedAudioEvidence": { "type": "boolean" },
        "canUseAsBusinessReadinessGeneratedAudioEvidence": { "const": false },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string", "minLength": 1 }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "safeBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "voiceId": { "type": "string", "minLength": 1 },
        "outputFormat": { "enum": ["mp3", "wav"] },
        "intentId": { "type": "string", "minLength": 1 },
        "providerAssetId": { "type": "string", "minLength": 1 },
        "predictionId": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "warn", "fail"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 360,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z]:\\\\" },
          { "pattern": "^/" },
          { "pattern": "https?://" },
          { "pattern": "\\.\\.(/|\\\\)" }
        ]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
