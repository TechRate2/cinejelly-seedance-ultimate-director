{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/commercial-launch-doctor-report.schema.json",
  "title": "CineJelly Commercial Launch Doctor Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "checkedInputs",
    "commandRuns",
    "reportSummaries",
    "commercialOfferScopeSummary",
    "operatorHandoffSummary",
    "snapshotParityCoverageSummary",
    "readinessSnapshot",
    "codeWorkSummary",
    "blockerSummary",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.commercial-launch-doctor.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "ready_for_customer_traffic",
        "ready_for_live_evidence_sequence",
        "blocked_by_external_inputs",
        "blocked_by_code_or_contracts"
      ]
    },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "skipLocalSmoke", "skipProviderHandoffSmokes", "timeoutMs", "commandCount"],
      "properties": {
        "outputPath": { "type": "string" },
        "markdownOutputPath": { "type": "string" },
        "skipLocalSmoke": { "type": "boolean" },
        "skipProviderHandoffSmokes": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 5000 },
        "commandCount": { "type": "integer", "minimum": 1 }
      }
    },
    "commandRuns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "startedAt",
          "finishedAt",
          "durationMs",
          "exitCode",
          "expectedExit",
          "status",
          "blocksCodeReadiness"
        ],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "exitCode": { "type": "integer" },
          "expectedExit": { "type": "boolean" },
          "status": { "enum": ["pass", "fail"] },
          "blocksCodeReadiness": { "type": "boolean" },
          "error": { "type": "string" },
          "signal": { "type": "string" },
          "diagnostic": { "type": "string" },
          "report": { "$ref": "#/$defs/reportSummary" }
        }
      }
    },
    "reportSummaries": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/reportSummary" }
    },
    "commercialOfferScopeSummary": { "$ref": "#/$defs/commercialOfferScopeSummary" },
    "operatorHandoffSummary": { "$ref": "#/$defs/operatorHandoffSummary" },
    "snapshotParityCoverageSummary": { "$ref": "#/$defs/snapshotParityCoverageSummary" },
    "readinessSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceCompletionPercent",
        "businessReadinessStatus",
        "releaseAuditStatus",
        "snapshotParityStatus",
        "qualityBenchmarkStatus",
        "qualityReviewDraftsStatus",
        "qualityReviewGuardStatus",
        "qualityReviewEvidenceStatus",
        "generatedAudioReviewDraftStatus",
        "longFormReviewDraftStatus",
        "providerReconciliationStatus",
        "providerHandoffStatus",
        "providerExternalLeaseStatus",
        "providerLeaseServiceStatus",
        "providerHandoffActionsStatus",
        "productionGraphResumeStateStatus",
        "productionGraphResumeQueueServiceStatus",
        "providerGraphResumeWorkerStatus",
        "providerMultiWorkerHandoffStatus",
        "providerLiveActionDraftStatus",
        "providerLiveActionsStatus",
        "providerGraphResumeDraftStatus",
        "providerGraphResumeStatus",
        "reportContractsStatus",
        "commercialInputsStatus",
        "opsConfigStatus",
        "liveInputsStatus",
        "launchIntakeStatus",
        "commercialOfferScopeStatus",
        "commercialOfferScopeConfigured",
        "uiRequiredBeforeCustomerTraffic",
        "commercialOfferScopeDecisionRequired",
        "commercialOfferBlocksApiCliCommercialLaunch",
        "readyPaidGates",
        "readyPaidGateCount",
        "canRunGeneratedAudioPaidSlice",
        "canRunFullKnownPaidSequence",
        "shouldDeferFullSequenceSpend",
        "canReleaseToCustomerTraffic"
      ],
      "properties": {
        "evidenceCompletionPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "businessReadinessStatus": { "type": "string" },
        "releaseAuditStatus": { "type": "string" },
        "snapshotParityStatus": { "type": "string" },
        "qualityBenchmarkStatus": { "type": "string" },
        "qualityReviewDraftsStatus": { "type": "string" },
        "qualityReviewGuardStatus": { "type": "string" },
        "qualityReviewEvidenceStatus": { "type": "string" },
        "generatedAudioReviewDraftStatus": { "type": "string" },
        "longFormReviewDraftStatus": { "type": "string" },
        "providerReconciliationStatus": { "type": "string" },
        "providerHandoffStatus": { "type": "string" },
        "providerExternalLeaseStatus": { "type": "string" },
        "providerLeaseServiceStatus": { "type": "string" },
        "providerHandoffActionsStatus": { "type": "string" },
        "productionGraphResumeStateStatus": { "type": "string" },
        "productionGraphResumeQueueServiceStatus": { "type": "string" },
        "providerGraphResumeWorkerStatus": { "type": "string" },
        "providerMultiWorkerHandoffStatus": { "type": "string" },
        "providerLiveActionDraftStatus": { "type": "string" },
        "providerLiveActionsStatus": { "type": "string" },
        "providerGraphResumeDraftStatus": { "type": "string" },
        "providerGraphResumeStatus": { "type": "string" },
        "reportContractsStatus": { "type": "string" },
        "commercialInputsStatus": { "type": "string" },
        "opsConfigStatus": { "type": "string" },
        "liveInputsStatus": { "type": "string" },
        "launchIntakeStatus": { "type": "string" },
        "commercialOfferScopeStatus": {
          "enum": [
            "missing_launch_intake_report",
            "scope_decision_pending",
            "api_cli_only_scoped",
            "first_party_web_ui_required"
          ]
        },
        "commercialOfferScopeConfigured": { "type": "boolean" },
        "commercialOfferProductSurface": { "enum": ["api_cli_only", "first_party_web_ui_required"] },
        "uiRequiredBeforeCustomerTraffic": { "type": "boolean" },
        "commercialOfferScopeDecisionRequired": { "type": "boolean" },
        "commercialOfferBlocksApiCliCommercialLaunch": { "type": "boolean" },
        "readyPaidGates": { "type": "array", "items": { "type": "string" } },
        "readyPaidGateCount": { "type": "integer", "minimum": 0 },
        "approvedBudgetUsd": { "type": "number", "minimum": 0 },
        "knownPaidEstimateUsd": { "type": "number", "minimum": 0 },
        "canRunGeneratedAudioPaidSlice": { "type": "boolean" },
        "canRunFullKnownPaidSequence": { "type": "boolean" },
        "shouldDeferFullSequenceSpend": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "type": "boolean" }
      }
    },
    "codeWorkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandPlanPass",
        "releaseAuditReady",
        "snapshotParityPass",
        "reportContractsPass",
        "knownCodeBlockingIssueCount",
        "unexpectedCodeCommandFailures",
        "message"
      ],
      "properties": {
        "commandPlanPass": { "type": "boolean" },
        "releaseAuditReady": { "type": "boolean" },
        "snapshotParityPass": { "type": "boolean" },
        "reportContractsPass": { "type": "boolean" },
        "knownCodeBlockingIssueCount": { "type": "integer", "minimum": 0 },
        "unexpectedCodeCommandFailures": { "type": "array", "items": { "type": "string" } },
        "message": { "type": "string" }
      }
    },
    "blockerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "automatableNow", "externalOrPaid", "byOwner", "byCategory"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "automatableNow": { "type": "integer", "minimum": 0 },
        "externalOrPaid": { "type": "integer", "minimum": 0 },
        "byOwner": { "$ref": "#/$defs/counts" },
        "byCategory": { "$ref": "#/$defs/counts" }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canReleaseToCustomerTraffic",
        "canRunNoSpendPrep",
        "canRunLiveNetworkEvidence",
        "canRunGeneratedAudioPaidSlice",
        "canRunFullKnownPaidSequence",
        "readyPaidGates",
        "readyPaidGateCount",
        "shouldDeferFullSequenceSpend",
        "knownCodeBlockingIssueCount",
        "commercialOfferScopeStatus",
        "commercialOfferBlocksApiCliCommercialLaunch",
        "releaseBlocker"
      ],
      "properties": {
        "canReleaseToCustomerTraffic": { "type": "boolean" },
        "canRunNoSpendPrep": { "type": "boolean" },
        "canRunLiveNetworkEvidence": { "type": "boolean" },
        "canRunGeneratedAudioPaidSlice": { "type": "boolean" },
        "canRunFullKnownPaidSequence": { "type": "boolean" },
        "readyPaidGates": { "type": "array", "items": { "type": "string" } },
        "readyPaidGateCount": { "type": "integer", "minimum": 0 },
        "shouldDeferFullSequenceSpend": { "type": "boolean" },
        "knownCodeBlockingIssueCount": { "type": "integer", "minimum": 0 },
        "commercialOfferScopeStatus": {
          "enum": [
            "missing_launch_intake_report",
            "scope_decision_pending",
            "api_cli_only_scoped",
            "first_party_web_ui_required"
          ]
        },
        "commercialOfferBlocksApiCliCommercialLaunch": { "type": "boolean" },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "string" }
  },
  "$defs": {
    "reportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "path", "status"],
      "properties": {
        "present": { "type": "boolean" },
        "path": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "commercialOfferScopeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchIntakePresent",
        "launchIntakeStatus",
        "configured",
        "status",
        "uiRequiredBeforeCustomerTraffic",
        "scopeDecisionRequired",
        "blocksApiCliCommercialLaunch",
        "blocksFullSnapshotParity",
        "sourceReport",
        "message"
      ],
      "properties": {
        "launchIntakePresent": { "type": "boolean" },
        "launchIntakeStatus": { "type": "string" },
        "configured": { "type": "boolean" },
        "status": {
          "enum": [
            "missing_launch_intake_report",
            "scope_decision_pending",
            "api_cli_only_scoped",
            "first_party_web_ui_required"
          ]
        },
        "productSurface": { "enum": ["api_cli_only", "first_party_web_ui_required"] },
        "uiRequiredBeforeCustomerTraffic": { "type": "boolean" },
        "scopeDecisionRequired": { "type": "boolean" },
        "blocksApiCliCommercialLaunch": { "type": "boolean" },
        "blocksFullSnapshotParity": { "type": "boolean" },
        "sourceReport": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "operatorHandoffSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "safeToShareWithOperators",
        "releaseEvidence",
        "secretValuesIncluded",
        "rawProviderPayloadsIncluded",
        "localAbsolutePathsIncluded",
        "customerMediaIncluded",
        "requiredInputCount",
        "configuredInputCount",
        "missingOrBlockedInputCount",
        "pendingAfterPaidRunCount",
        "operatorInputFileCount",
        "draftFileCount",
        "reportArchiveFileCount",
        "commandCount",
        "readyCommandCount",
        "blockedCommandCount",
        "paidCommandCount",
        "readyPaidCommandCount",
        "commandPlanAuditStatus",
        "blockedInputIds",
        "operatorInputFiles",
        "refreshCommands"
      ],
      "properties": {
        "source": {
          "enum": [
            "commercial_launch_inputs",
            "missing_commercial_launch_inputs_manifest"
          ]
        },
        "status": { "type": "string" },
        "safeToShareWithOperators": { "type": "boolean" },
        "releaseEvidence": { "type": "boolean" },
        "secretValuesIncluded": { "type": "boolean" },
        "rawProviderPayloadsIncluded": { "type": "boolean" },
        "localAbsolutePathsIncluded": { "type": "boolean" },
        "customerMediaIncluded": { "type": "boolean" },
        "requiredInputCount": { "type": "integer", "minimum": 0 },
        "configuredInputCount": { "type": "integer", "minimum": 0 },
        "missingOrBlockedInputCount": { "type": "integer", "minimum": 0 },
        "pendingAfterPaidRunCount": { "type": "integer", "minimum": 0 },
        "operatorInputFileCount": { "type": "integer", "minimum": 0 },
        "draftFileCount": { "type": "integer", "minimum": 0 },
        "reportArchiveFileCount": { "type": "integer", "minimum": 0 },
        "commandCount": { "type": "integer", "minimum": 0 },
        "readyCommandCount": { "type": "integer", "minimum": 0 },
        "blockedCommandCount": { "type": "integer", "minimum": 0 },
        "paidCommandCount": { "type": "integer", "minimum": 0 },
        "readyPaidCommandCount": { "type": "integer", "minimum": 0 },
        "commandPlanAuditStatus": { "type": "string" },
        "blockedInputIds": { "type": "array", "items": { "type": "string" } },
        "operatorInputFiles": { "type": "array", "items": { "type": "string" } },
        "refreshCommands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "snapshotParityCoverageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "guardrailsPass",
        "canClaimFullSnapshotParity",
        "releaseEvidence",
        "sourceEstimateCount",
        "estimatedSourceCount",
        "lowestEstimatePercent",
        "highestEstimatePercent",
        "averageEstimateMinPercent",
        "averageEstimateMaxPercent",
        "sourceEstimates"
      ],
      "properties": {
        "source": {
          "enum": [
            "snapshot_parity_audit",
            "missing_snapshot_parity_estimates"
          ]
        },
        "status": { "type": "string" },
        "guardrailsPass": { "type": "boolean" },
        "canClaimFullSnapshotParity": { "type": "boolean" },
        "releaseEvidence": { "const": false },
        "sourceEstimateCount": { "type": "integer", "minimum": 0 },
        "estimatedSourceCount": { "type": "integer", "minimum": 0 },
        "lowestEstimatePercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "highestEstimatePercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "averageEstimateMinPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "averageEstimateMaxPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "sourceEstimates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "localPath",
              "upstreamRepository",
              "estimateMinPercent",
              "estimateMaxPercent",
              "estimateText",
              "mainGaps"
            ],
            "properties": {
              "id": { "type": "string" },
              "localPath": { "type": "string" },
              "upstreamRepository": { "type": "string" },
              "estimateMinPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
              "estimateMaxPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
              "estimateText": { "type": "string" },
              "mainGaps": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
