{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/render-provider-production-handoff-report.schema.json",
  "title": "CineJelly Render Provider Production Handoff Capture Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "externalNetworkCallsMade",
    "localHttpCallsMade",
    "providerCallsMade",
    "renderCallsMade",
    "environmentKind",
    "checkedInputs",
    "summary",
    "operations",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.render-provider-production-handoff-capture.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "externalNetworkCallsMade": { "type": "boolean" },
    "localHttpCallsMade": { "type": "boolean" },
    "providerCallsMade": { "const": false },
    "renderCallsMade": { "const": false },
    "environmentKind": { "enum": ["deployment", "local"] },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "deploymentBaseUrlSha256",
        "endpointPath",
        "outputPath",
        "authTokenEnv",
        "authTokenProvided",
        "timeoutMs",
        "ttlMs",
        "jobIdConfigured"
      ],
      "properties": {
        "baseUrl": { "type": "string" },
        "deploymentBaseUrlSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "endpointPath": { "const": "/v1/render-provider-handoff-leases" },
        "outputPath": { "type": "string" },
        "authTokenEnv": { "type": "string" },
        "authTokenProvided": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "ttlMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "jobIdConfigured": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerCallsMade",
        "renderCallsMade",
        "operationCount",
        "failedOperationCount",
        "skippedOperationCount",
        "workerAAcquireStatus",
        "workerBImmediateAcquireStatus",
        "workerBAfterReleaseAcquireStatus",
        "activeAfterCleanupCount",
        "probeLeaseHistoryObserved",
        "canClaimDistributedResume"
      ],
      "properties": {
        "providerCallsMade": { "const": false },
        "renderCallsMade": { "const": false },
        "operationCount": { "type": "integer", "minimum": 0 },
        "failedOperationCount": { "type": "integer", "minimum": 0 },
        "skippedOperationCount": { "type": "integer", "minimum": 0 },
        "workerAAcquireStatus": { "type": "string" },
        "workerBImmediateAcquireStatus": { "type": "string" },
        "workerBAfterReleaseAcquireStatus": { "type": "string" },
        "activeAfterCleanupCount": { "type": "integer", "minimum": 0 },
        "probeLeaseHistoryObserved": { "type": "boolean" },
        "canClaimDistributedResume": { "const": false }
      }
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionHandoffCapturePass",
        "canUseAsProductionHandoffEvidence",
        "canClaimDistributedResume",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "productionHandoffCapturePass": { "type": "boolean" },
        "canUseAsProductionHandoffEvidence": { "type": "boolean" },
        "canClaimDistributedResume": { "const": false },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "method", "path", "ok", "durationMs", "status", "message"],
      "properties": {
        "name": { "type": "string" },
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string" },
        "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "ok": { "type": "boolean" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["pass", "fail", "skipped"] },
        "message": { "type": "string" },
        "response": true,
        "error": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "message": { "type": "string" }
      }
    }
  }
}
