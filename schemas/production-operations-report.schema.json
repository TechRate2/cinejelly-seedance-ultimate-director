{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/production-operations-report.schema.json",
  "title": "CineJelly Production Operations Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "environmentKind",
    "checkedInputs",
    "checks",
    "attestation",
    "endpointCapture",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.production-operations.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "warn", "fail"] },
    "environmentKind": { "enum": ["deployment", "local"] },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestationPath", "deploymentBaseUrlConfigured", "authTokenEnv", "authTokenProvided"],
      "properties": {
        "attestationPath": { "type": "string" },
        "deploymentBaseUrlConfigured": { "type": "boolean" },
        "authTokenEnv": { "type": "string" },
        "authTokenProvided": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["configured"],
      "properties": {
        "configured": { "type": "boolean" },
        "path": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string" },
        "operationsOwner": { "type": "string" },
        "supportContact": { "type": "string" },
        "securityContact": { "type": "string" },
        "storageProvider": { "type": "string" },
        "artifactRetentionDays": { "type": "integer", "minimum": 0 },
        "observabilityProvider": { "type": "string" },
        "monitoringDashboardUrl": { "type": "string" },
        "incidentRunbookUrl": { "type": "string" },
        "supportRunbookUrl": { "type": "string" },
        "dataRetentionPolicyUrl": { "type": "string" }
      }
    },
    "endpointCapture": {
      "type": "object",
      "additionalProperties": true,
      "required": ["captured"],
      "properties": {
        "captured": { "type": "boolean" },
        "baseUrl": { "type": "string" },
        "environmentKind": { "type": "string" },
        "authTokenProvided": { "type": "boolean" },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "method", "path", "ok", "durationMs"],
            "properties": {
              "name": { "enum": ["health", "preflight", "validation_readiness", "render_settings"] },
              "method": { "const": "GET" },
              "path": { "type": "string" },
              "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
              "ok": { "type": "boolean" },
              "durationMs": { "type": "integer", "minimum": 0 },
              "payload": true,
              "error": { "type": "string" }
            }
          }
        },
        "requiredPreflightChecks": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canUseAsBusinessReadinessOperationsEvidence", "canOpenPaidCustomerTraffic", "releaseBlocker"],
      "properties": {
        "canUseAsBusinessReadinessOperationsEvidence": { "type": "boolean" },
        "canOpenPaidCustomerTraffic": { "type": "boolean" },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
