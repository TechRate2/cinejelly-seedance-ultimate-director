{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/short-backend-integration-audit-report.schema.json",
  "title": "CineJelly Short Backend Integration Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "checkedInputs",
    "sourceRoots",
    "newCorpusReachability",
    "disconnectedScopedFiles",
    "zeroInboundScopedFiles",
    "checks",
    "releaseGateSummary"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.short-backend-integration-audit.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFileCount", "scriptFileCount", "sourceRootCount", "scopedFileCount", "reachableScopedFileCount"],
      "properties": {
        "sourceFileCount": { "type": "integer", "minimum": 1 },
        "scriptFileCount": { "type": "integer", "minimum": 1 },
        "sourceRootCount": { "type": "integer", "minimum": 1 },
        "scopedFileCount": { "type": "integer", "minimum": 1 },
        "reachableScopedFileCount": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "newCorpusReachability": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filePath", "exists", "reachableFromBackendOrValidation", "inboundImportCount"],
        "properties": {
          "filePath": { "type": "string", "minLength": 1 },
          "exists": { "const": true },
          "reachableFromBackendOrValidation": { "const": true },
          "inboundImportCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "disconnectedScopedFiles": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "zeroInboundScopedFiles": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canUseAsNoSpendBackendIntegrationEvidence", "canReleaseToCustomerTraffic", "releaseBlocker"],
      "properties": {
        "canUseAsNoSpendBackendIntegrationEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string", "minLength": 1 }
      }
    }
  }
}
