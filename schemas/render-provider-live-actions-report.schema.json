{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/render-provider-live-actions-report.schema.json",
  "title": "CineJelly Render Provider Live Actions Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "checkedInputs",
    "summary",
    "evidence",
    "executions",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.render-provider-live-actions.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "blocked_by_missing_inputs", "blocked_by_confirmation", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidencePath",
        "productionHandoffPath",
        "outputPath",
        "evidenceConfigured",
        "productionHandoffReportPresent",
        "confirmLiveProviderActions"
      ],
      "properties": {
        "evidencePath": { "type": "string", "minLength": 1 },
        "productionHandoffPath": { "type": "string", "minLength": 1 },
        "outputPath": { "type": "string", "minLength": 1 },
        "evidenceConfigured": { "type": "boolean" },
        "productionHandoffReportPresent": { "type": "boolean" },
        "confirmLiveProviderActions": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceExecutionCount",
        "providerCallEvidenceCount",
        "resumePollingEvidenceCount",
        "graphResumeEvidenceCount",
        "terminalCloseEvidenceCount",
        "manualAuditEvidenceCount",
        "redactionReviewedCount",
        "productionHandoffStatus",
        "productionHandoffUsable",
        "productionHandoffDeploymentMatch",
        "canUseAsLiveProviderActionEvidence",
        "canUseAsGraphResumeEvidence",
        "canClaimDistributedResume"
      ],
      "properties": {
        "evidenceExecutionCount": { "type": "integer", "minimum": 0 },
        "providerCallEvidenceCount": { "type": "integer", "minimum": 0 },
        "resumePollingEvidenceCount": { "type": "integer", "minimum": 0 },
        "graphResumeEvidenceCount": { "type": "integer", "minimum": 0 },
        "terminalCloseEvidenceCount": { "type": "integer", "minimum": 0 },
        "manualAuditEvidenceCount": { "type": "integer", "minimum": 0 },
        "redactionReviewedCount": { "type": "integer", "minimum": 0 },
        "productionHandoffStatus": { "type": "string" },
        "productionHandoffUsable": { "type": "boolean" },
        "productionHandoffDeploymentMatch": { "type": "boolean" },
        "canUseAsLiveProviderActionEvidence": { "type": "boolean" },
        "canUseAsGraphResumeEvidence": { "type": "boolean" },
        "canClaimDistributedResume": { "const": false }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured"],
      "properties": {
        "configured": { "type": "boolean" },
        "schemaVersion": { "type": "string" },
        "environmentKind": { "type": "string" },
        "deploymentBaseUrl": { "type": "string" },
        "deploymentBaseUrlSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "executionCount": { "type": "integer", "minimum": 0 }
      }
    },
    "executions": {
      "type": "array",
      "items": { "$ref": "#/$defs/execution" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveProviderActionEvidencePass",
        "graphResumeEvidencePass",
        "canUseAsDistributedResumeEvidence",
        "canClaimDistributedResume",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "liveProviderActionEvidencePass": { "type": "boolean" },
        "graphResumeEvidencePass": { "type": "boolean" },
        "canUseAsDistributedResumeEvidence": { "type": "boolean" },
        "canClaimDistributedResume": { "const": false },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string", "minLength": 1 }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "safeEvidenceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {
        "anyOf": [
          { "pattern": "Bearer\\s+[A-Za-z0-9._-]+" },
          { "pattern": "sk-[A-Za-z0-9_-]+" },
          { "pattern": "(api[_-]?key|access[_-]?key|token|secret|password|signature|credential|authorization)\\s*[:=]\\s*[\\\"']?[^\\\"',\\s&]+" },
          { "pattern": "([?&](?:api[_-]?key|access[_-]?key|token|secret|password|signature|credential|authorization)=)[^&#\\s]+" },
          { "pattern": "[A-Za-z]:\\\\[^\\s\\\"'<>]+" },
          { "pattern": "\\/(?:home|Users|var|tmp)\\/[^\\s\\\"'<>]+" },
          { "pattern": "https?:\\/\\/[^\\s\\\"'<>]+" },
          { "pattern": "(?:file|s3|gs|ftp):\\/\\/[^\\s\\\"'<>]+" },
          { "pattern": "data:[^\\s\\\"'<>]+" }
        ]
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "jobId",
        "action",
        "provider",
        "providerCallKind",
        "providerCallMade",
        "resultStatus",
        "executedAt",
        "predictionIdCount",
        "evidenceSummary",
        "redactionReviewed",
        "rawProviderPayloadStored",
        "outputUrlsStored"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "resume_polling" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "providerCallKind": { "enum": ["prediction_poll", "graph_resume_enqueue"] },
              "resultStatus": { "enum": ["still_active", "resume_enqueued"] }
            }
          }
        },
        {
          "if": {
            "properties": { "providerCallKind": { "const": "graph_resume_enqueue" } },
            "required": ["providerCallKind"]
          },
          "then": {
            "properties": {
              "action": { "const": "resume_polling" },
              "resultStatus": { "const": "resume_enqueued" }
            }
          }
        },
        {
          "if": {
            "properties": { "resultStatus": { "const": "resume_enqueued" } },
            "required": ["resultStatus"]
          },
          "then": {
            "properties": {
              "action": { "const": "resume_polling" },
              "providerCallKind": { "const": "graph_resume_enqueue" }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "enum": ["close_terminal_succeeded", "close_terminal_failed", "close_terminal_canceled", "close_terminal_timeout", "close_terminal_mixed"] } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "providerCallKind": { "enum": ["terminal_closeout", "provider_cancel_or_close"] },
              "resultStatus": { "enum": ["succeeded", "terminal_failed", "closeout_recorded"] }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "manual_audit_required" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "providerCallKind": { "const": "manual_audit_enqueue" },
              "resultStatus": { "const": "manual_audit_queued" }
            }
          }
        }
      ],
      "properties": {
        "actionId": { "type": "string", "minLength": 1 },
        "jobId": { "type": "string", "minLength": 1 },
        "action": {
          "enum": [
            "resume_polling",
            "close_terminal_succeeded",
            "close_terminal_failed",
            "close_terminal_canceled",
            "close_terminal_timeout",
            "close_terminal_mixed",
            "manual_audit_required"
          ]
        },
        "provider": { "type": "string", "minLength": 1 },
        "providerCallKind": {
          "enum": [
            "prediction_poll",
            "terminal_closeout",
            "manual_audit_enqueue",
            "provider_cancel_or_close",
            "graph_resume_enqueue"
          ]
        },
        "providerCallMade": { "const": true },
        "resultStatus": {
          "enum": [
            "succeeded",
            "still_active",
            "terminal_failed",
            "manual_audit_queued",
            "resume_enqueued",
            "closeout_recorded"
          ]
        },
        "executedAt": { "type": "string", "format": "date-time" },
        "predictionIdCount": { "type": "integer", "minimum": 0 },
        "evidenceSummary": { "$ref": "#/$defs/safeEvidenceText" },
        "redactionReviewed": { "type": "boolean" },
        "rawProviderPayloadStored": { "type": "boolean" },
        "outputUrlsStored": { "type": "boolean" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
