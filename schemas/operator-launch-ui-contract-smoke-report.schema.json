{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/operator-launch-ui-contract-smoke-report.schema.json",
  "title": "CineJelly Operator Launch UI Contract Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "localHttpCallsMade",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "scenarios",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.operator-launch-ui-contract-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "localHttpCallsMade": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputPath",
        "endpointPaths",
        "dashboardStatusCode",
        "unauthorizedStatusCode",
        "authorizedStatusCode",
        "sourceReportCount",
        "productGapCount",
        "nextActionCount",
        "redactionCheckPassed",
        "htmlSecurityHeadersCheckPassed"
      ],
      "properties": {
        "outputPath": { "type": "string" },
        "endpointPaths": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "GET /operator/launch-dashboard",
              "GET /v1/admin/operator-launch-ui-contract"
            ]
          }
        },
        "dashboardStatusCode": { "const": 200 },
        "unauthorizedStatusCode": { "const": 401 },
        "authorizedStatusCode": { "const": 200 },
        "sourceReportCount": { "type": "integer", "minimum": 8 },
        "productGapCount": { "type": "integer", "minimum": 3 },
        "nextActionCount": { "type": "integer", "minimum": 8 },
        "redactionCheckPassed": { "const": true },
        "htmlSecurityHeadersCheckPassed": { "const": true }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboardStatus",
        "evidenceCompletionPercent",
        "reportContractsStatus",
        "budgetFit",
        "readyPaidGateCount",
        "missingOrBlockedInputCount",
        "canReleaseToCustomerTraffic"
      ],
      "properties": {
        "dashboardStatus": {
          "enum": [
            "ready",
            "review_required",
            "blocked",
            "blocked_by_external_inputs",
            "blocked_by_operator_inputs",
            "missing_evidence",
            "scope_decision_required"
          ]
        },
        "evidenceCompletionPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "reportContractsStatus": { "type": "string" },
        "budgetFit": { "type": "string" },
        "readyPaidGateCount": { "type": "integer", "minimum": 0 },
        "missingOrBlockedInputCount": { "type": "integer", "minimum": 0 },
        "canReleaseToCustomerTraffic": { "const": false }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatorLaunchUiContractSmokePass",
        "canUseAsNoSpendBackendEvidence",
        "readyForOperatorDashboard",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "operatorLaunchUiContractSmokePass": { "type": "boolean" },
        "canUseAsNoSpendBackendEvidence": { "type": "boolean" },
        "readyForOperatorDashboard": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
