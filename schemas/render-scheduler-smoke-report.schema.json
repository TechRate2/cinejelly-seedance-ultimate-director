{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/render-scheduler-smoke-report.schema.json",
  "title": "CineJelly Render Scheduler Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "scenarios",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.render-scheduler-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "concurrency", "scenarioCount"],
      "properties": {
        "outputPath": { "type": "string" },
        "concurrency": { "type": "integer", "minimum": 1 },
        "scenarioCount": { "type": "integer", "minimum": 5 }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scenario" },
      "required": [
        "parallelSafe",
        "endpointAnchored",
        "sourceVideoStructured",
        "continuityRisk",
        "transitionIntent"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/check" }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canUseAsNoSpendLongFormSchedulerEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "canUseAsNoSpendLongFormSchedulerEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string", "minLength": 1 }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemCount",
        "batchCount",
        "parallelBatchCount",
        "sequentialItemCount",
        "items"
      ],
      "properties": {
        "itemCount": { "type": "integer", "minimum": 1 },
        "batchCount": { "type": "integer", "minimum": 1 },
        "parallelBatchCount": { "type": "integer", "minimum": 0 },
        "sequentialItemCount": { "type": "integer", "minimum": 0 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scheduleItem" }
        }
      }
    },
    "scheduleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shotId", "mode", "batchId", "sequentialReasons"],
      "properties": {
        "shotId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["parallel", "sequential"] },
        "batchId": { "type": "string", "pattern": "^render_batch_[0-9]{3}$" },
        "sequentialReasons": {
          "type": "array",
          "items": {
            "enum": [
              "endpoint_reference",
              "endpoint_continuity",
              "source_video_structure",
              "source_video_timeline",
              "continuity_risk",
              "transition_risk",
              "transition_intent"
            ]
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
