{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/generated-audio-mapping-smoke-report.schema.json",
  "title": "CineJelly Generated Audio Mapping Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "summary",
    "plans",
    "outputValidation",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.generated-audio-mapping-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputPath",
        "syntheticIntentCount",
        "syntheticCapabilityCount",
        "scenarioCount",
        "outputFormat"
      ],
      "properties": {
        "outputPath": { "$ref": "#/$defs/repoPath" },
        "syntheticIntentCount": { "const": 4 },
        "syntheticCapabilityCount": { "type": "integer", "minimum": 3 },
        "scenarioCount": { "type": "integer", "minimum": 5 },
        "outputFormat": { "const": "mp3" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentKindCoverage",
        "readyKindCounts",
        "approvedTrackRoleCounts",
        "blockedReasonCounts",
        "outputValidationApprovedCount",
        "kindMismatchRejected",
        "rawOutputUrlStored",
        "rawPromptStored"
      ],
      "properties": {
        "intentKindCoverage": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["tts_narration", "bgm", "ambience", "sfx"] }
        },
        "readyKindCounts": { "$ref": "#/$defs/counts" },
        "approvedTrackRoleCounts": { "$ref": "#/$defs/counts" },
        "blockedReasonCounts": { "$ref": "#/$defs/counts" },
        "outputValidationApprovedCount": { "const": 4 },
        "kindMismatchRejected": { "const": true },
        "rawOutputUrlStored": { "const": false },
        "rawPromptStored": { "const": false }
      }
    },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allKindsReady",
        "partialKindBoundary",
        "providerPreferenceBinding",
        "durationBoundary"
      ],
      "properties": {
        "allKindsReady": { "$ref": "#/$defs/planSummary" },
        "partialKindBoundary": { "$ref": "#/$defs/planSummary" },
        "providerPreferenceBinding": { "$ref": "#/$defs/planSummary" },
        "durationBoundary": { "$ref": "#/$defs/planSummary" }
      }
    },
    "outputValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedTracks", "kindMismatch"],
      "properties": {
        "approvedTracks": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/approvedTrack" }
        },
        "kindMismatch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "issueCodes", "audioTrackCreated"],
          "properties": {
            "status": { "const": "rejected" },
            "issueCodes": {
              "type": "array",
              "contains": { "const": "kind_mismatch" },
              "items": { "type": "string", "minLength": 1 }
            },
            "audioTrackCreated": { "const": false }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/check" }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAudioMappingSmokePass",
        "canUseAsNoSpendBackendEvidence",
        "canUseAsLiveGeneratedAudioEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "generatedAudioMappingSmokePass": { "type": "boolean" },
        "canUseAsNoSpendBackendEvidence": { "type": "boolean" },
        "canUseAsLiveGeneratedAudioEvidence": { "const": false },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string", "minLength": 1 }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "planSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "intentCount",
        "readyCount",
        "blockedCount",
        "requestedDurationSeconds",
        "outputFormat",
        "readyItems",
        "blockedItems"
      ],
      "properties": {
        "status": {
          "enum": ["not_requested", "planned_only", "ready_for_provider", "partially_ready"]
        },
        "intentCount": { "type": "integer", "minimum": 0 },
        "readyCount": { "type": "integer", "minimum": 0 },
        "blockedCount": { "type": "integer", "minimum": 0 },
        "requestedDurationSeconds": { "type": "number", "minimum": 0 },
        "outputFormat": { "const": "mp3" },
        "readyItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/readyItem" }
        },
        "blockedItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockedItem" }
        }
      }
    },
    "readyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "kind",
        "provider",
        "modelId",
        "maxDurationSeconds",
        "requestOutputFormat"
      ],
      "properties": {
        "intentId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["tts_narration", "bgm", "ambience", "sfx"] },
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "maxDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "requestedDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "requestOutputFormat": { "const": "mp3" }
      }
    },
    "blockedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "kind",
        "reason",
        "candidateProviderCount",
        "candidateKindCount"
      ],
      "properties": {
        "intentId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["tts_narration", "bgm", "ambience", "sfx"] },
        "providerPreference": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reason": {
          "enum": [
            "provider_not_configured",
            "provider_preference_unavailable",
            "kind_not_supported",
            "duration_exceeds_capability",
            "output_format_not_supported",
            "invalid_duration"
          ]
        },
        "requestedDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "candidateProviderCount": { "type": "integer", "minimum": 0 },
        "candidateKindCount": { "type": "integer", "minimum": 0 }
      }
    },
    "approvedTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "kind",
        "status",
        "issueCount",
        "role",
        "volume",
        "outputUrlSha256"
      ],
      "properties": {
        "intentId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["tts_narration", "bgm", "ambience", "sfx"] },
        "status": { "const": "approved" },
        "issueCount": { "const": 0 },
        "role": { "enum": ["narration", "music", "ambience", "sfx"] },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 },
        "outputUrlSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 360,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z]:\\\\" },
          { "pattern": "^/" },
          { "pattern": "https?://" },
          { "pattern": "\\.\\.(/|\\\\)" }
        ]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
