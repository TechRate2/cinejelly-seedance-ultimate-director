{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/phase6-release-audit-report.schema.json",
  "title": "CineJelly Phase 6 Release Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "sourcePatternOrigins",
    "checkedInputs",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.phase6.release-audit.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["blocked", "review_warnings", "release_ready"] },
    "sourcePatternOrigins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smokeReportPath", "paidReportPath"],
      "properties": {
        "smokeReportPath": { "type": "string" },
        "paidReportPath": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail"] },
          "message": { "type": "string" },
          "findings": {
            "type": "array",
            "items": { "$ref": "#/$defs/finding" }
          }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canRunPaidValidation", "canUseAsPhase6ReleaseEvidence", "canReleaseToCustomerTraffic"],
      "properties": {
        "canRunPaidValidation": { "type": "boolean" },
        "canUseAsPhase6ReleaseEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error": { "type": "string" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "integer", "number", "boolean"]
      }
    }
  }
}
