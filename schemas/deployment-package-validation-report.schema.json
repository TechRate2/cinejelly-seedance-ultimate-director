{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/deployment-package-validation-report.schema.json",
  "title": "CineJelly Deployment Package Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "dockerBuildAttempted",
    "checkedInputs",
    "summary",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.deployment-package-validation.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "dockerBuildAttempted": { "const": false },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dockerfilePath", "dockerignorePath", "envTemplatePath", "containerDocPath", "outputPath"],
      "properties": {
        "dockerfilePath": { "type": "string" },
        "dockerignorePath": { "type": "string" },
        "envTemplatePath": { "type": "string" },
        "containerDocPath": { "type": "string" },
        "outputPath": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentPackageReady",
        "canUseAsDeploymentReadinessEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "deploymentPackageReady": { "type": "boolean" },
        "canUseAsDeploymentReadinessEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "type": "boolean" },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error": { "type": "string" }
  }
}
