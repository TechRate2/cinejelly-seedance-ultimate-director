{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/director-style-governance-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewerType", "checks"],
  "properties": {
    "schemaVersion": { "const": "cinejelly.director-style-governance-review.v1" },
    "reviewerType": { "$ref": "#/$defs/reviewerType" },
    "status": { "$ref": "#/$defs/reviewStatus" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  },
  "$defs": {
    "reviewerType": { "enum": ["operator", "legal", "product", "security", "hybrid"] },
    "reviewStatus": { "enum": ["accepted", "needs_review", "rejected"] },
    "checkName": {
      "enum": [
        "directorbench_license_boundary",
        "upstream_code_reuse_boundary",
        "runtime_evaluator_independence",
        "evaluation_asset_permissions"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkName", "status", "evidenceSummary"],
      "properties": {
        "checkName": { "$ref": "#/$defs/checkName" },
        "status": { "$ref": "#/$defs/reviewStatus" },
        "reviewerType": { "$ref": "#/$defs/reviewerType" },
        "evidenceSummary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    }
  }
}
