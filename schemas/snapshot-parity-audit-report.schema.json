{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/snapshot-parity-audit-report.schema.json",
  "title": "CineJelly Snapshot Parity Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "checkedInputs",
    "summary",
    "snapshotInventory",
    "functionalParityEstimates",
    "referenceImplementations",
    "directExternalImports",
    "sourceHygiene",
    "checks",
    "releaseGateSummary",
    "nextActions",
    "undeclaredSnapshots"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cinejelly.snapshot-parity-audit.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "noSpend": {
      "const": true
    },
    "networkCallsMade": {
      "const": false
    },
    "providerCallsMade": {
      "const": false
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedSnapshotCount",
        "requiredDocumentCount",
        "requiredReferenceImplementationCount",
        "scannedSourceRoots",
        "sourceHygieneRoots",
        "outputPath"
      ],
      "properties": {
        "expectedSnapshotCount": {
          "type": "integer",
          "minimum": 0
        },
        "requiredDocumentCount": {
          "type": "integer",
          "minimum": 0
        },
        "requiredReferenceImplementationCount": {
          "type": "integer",
          "minimum": 0
        },
        "scannedSourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceHygieneRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputPath": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotDirectoriesPresent",
        "expectedSnapshotCount",
        "inventoryCoverageCount",
        "sourceLineageCoverageCount",
        "functionalParityEstimateCount",
        "lowestSnapshotParityEstimatePercent",
        "highestSnapshotParityEstimatePercent",
        "averageSnapshotParityEstimateMinPercent",
        "averageSnapshotParityEstimateMaxPercent",
        "referenceImplementationCount",
        "directExternalImportFindingCount",
        "productOwnedTestMockFindingCount",
        "externalSnapshotPrunableFileCount",
        "passedChecks",
        "warningChecks",
        "failedChecks"
      ],
      "properties": {
        "snapshotDirectoriesPresent": {
          "type": "integer",
          "minimum": 0
        },
        "expectedSnapshotCount": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryCoverageCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceLineageCoverageCount": {
          "type": "integer",
          "minimum": 0
        },
        "functionalParityEstimateCount": {
          "type": "integer",
          "minimum": 0
        },
        "lowestSnapshotParityEstimatePercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "highestSnapshotParityEstimatePercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "averageSnapshotParityEstimateMinPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "averageSnapshotParityEstimateMaxPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "referenceImplementationCount": {
          "type": "integer",
          "minimum": 0
        },
        "directExternalImportFindingCount": {
          "type": "integer",
          "minimum": 0
        },
        "productOwnedTestMockFindingCount": {
          "type": "integer",
          "minimum": 0
        },
        "externalSnapshotPrunableFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "passedChecks": {
          "type": "integer",
          "minimum": 0
        },
        "warningChecks": {
          "type": "integer",
          "minimum": 0
        },
        "failedChecks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "snapshotInventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshotInventoryItem"
      }
    },
    "functionalParityEstimates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/functionalParityEstimateItem"
      }
    },
    "referenceImplementations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceImplementationItem"
      }
    },
    "directExternalImports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "sourceHygiene": {
      "$ref": "#/$defs/sourceHygiene"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotGuardrailsPass",
        "canClaimFullSnapshotParity",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "snapshotGuardrailsPass": {
          "type": "boolean"
        },
        "canClaimFullSnapshotParity": {
          "type": "boolean"
        },
        "canReleaseToCustomerTraffic": {
          "type": "boolean"
        },
        "releaseBlocker": {
          "type": "string"
        }
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "undeclaredSnapshots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Snapshot directories present on disk but not declared with a license. Must be empty."
    }
  },
  "$defs": {
    "sourceHygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "hygienePolicy",
        "productOwnedScannedRoots",
        "productOwnedFileCount",
        "productOwnedTestMockFindingCount",
        "productOwnedTestMockFindingsSample",
        "externalSnapshotFileCount",
        "externalSnapshotPrunableFileCount",
        "externalSnapshotPrunableFilesSample"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "hygienePolicy": {
          "type": "string"
        },
        "productOwnedScannedRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "productOwnedFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "productOwnedTestMockFindingCount": {
          "type": "integer",
          "minimum": 0
        },
        "productOwnedTestMockFindingsSample": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalSnapshotFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "externalSnapshotPrunableFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "externalSnapshotPrunableFilesSample": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "snapshotInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "localPath",
        "upstreamRepository",
        "license",
        "status",
        "directoryPresent",
        "fileCount",
        "inventoryCovered",
        "subtreePolicyCovered",
        "parityAuditCovered",
        "projectContextCovered",
        "sourceLineageCovered",
        "referenceOnly"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "localPath": {
          "type": "string"
        },
        "upstreamRepository": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "directoryPresent": {
          "type": "boolean"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryCovered": {
          "type": "boolean"
        },
        "subtreePolicyCovered": {
          "type": "boolean"
        },
        "parityAuditCovered": {
          "type": "boolean"
        },
        "projectContextCovered": {
          "type": "boolean"
        },
        "sourceLineageCovered": {
          "type": "boolean"
        },
        "referenceOnly": {
          "type": "boolean",
          "description": "Reference-only snapshot: inventoried and policed, but its license forbids copying code, so it carries no source-lineage record."
        }
      }
    },
    "functionalParityEstimateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "localPath",
        "upstreamRepository",
        "status",
        "estimateMinPercent",
        "estimateMaxPercent",
        "estimateText",
        "mainCapability",
        "implementedCoverage",
        "mainGaps",
        "sourceAuditPath",
        "releaseEvidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "localPath": {
          "type": "string"
        },
        "upstreamRepository": {
          "type": "string"
        },
        "status": {
          "enum": [
            "estimated",
            "missing_estimate"
          ]
        },
        "estimateMinPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "estimateMaxPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "estimateText": {
          "type": "string"
        },
        "mainCapability": {
          "type": "string"
        },
        "implementedCoverage": {
          "type": "string"
        },
        "mainGaps": {
          "type": "string"
        },
        "sourceAuditPath": {
          "type": "string"
        },
        "releaseEvidence": {
          "const": false
        }
      }
    },
    "referenceImplementationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "present",
        "hasPurposeSection",
        "hasAcceptanceSection"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        },
        "hasPurposeSection": {
          "type": "boolean"
        },
        "hasAcceptanceSection": {
          "type": "boolean"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "blocker": {
          "type": "string"
        }
      }
    }
  }
}
