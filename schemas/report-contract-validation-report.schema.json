{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/report-contract-validation-report.schema.json",
  "title": "CineJelly Report Contract Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "checkedInputs",
    "summary",
    "contracts",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.report-contract-validation.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractCount", "outputPath", "maxIssuesPerContract"],
      "properties": {
        "contractCount": { "type": "integer", "minimum": 0 },
        "outputPath": { "type": "string" },
        "maxIssuesPerContract": { "type": "integer", "minimum": 1 },
        "allowLaunchDoctorInProgress": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "schemaPath", "reportPath", "issueCount", "issues", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail", "skipped"] },
          "schemaPath": { "type": "string" },
          "reportPath": { "type": "string" },
          "schemaVersion": { "type": "string" },
          "reportStatus": { "type": "string" },
          "issueCount": { "type": "integer", "minimum": 0 },
          "issues": { "type": "array", "items": { "type": "string" } },
          "message": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportContractsPass", "canReleaseToCustomerTraffic", "releaseBlocker"],
      "properties": {
        "reportContractsPass": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "type": "boolean" },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "string" }
  }
}
