{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/director-style-semantic-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewerType", "metrics"],
  "properties": {
    "schemaVersion": { "const": "cinejelly.director-style-semantic-review.v1" },
    "reviewerType": { "$ref": "#/$defs/reviewerType" },
    "status": { "$ref": "#/$defs/reviewStatus" },
    "artifactBinding": { "$ref": "#/$defs/artifactBinding" },
    "reviewedShotCount": { "type": "integer", "minimum": 0 },
    "reviewedBoundaryCount": { "type": "integer", "minimum": 0 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric" }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/safeReviewText" } }
  },
  "$defs": {
    "safeReviewText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {
        "anyOf": [
          { "pattern": "Bearer\\s+[A-Za-z0-9._-]+" },
          { "pattern": "sk-[A-Za-z0-9_-]+" },
          { "pattern": "apikey-[A-Za-z0-9]{20,}" },
          { "pattern": "(api[_-]?key|access[_-]?key|token|secret|password|signature|credential|authorization)\\s*[:=]\\s*[\\\"']?[^\\\"',\\s&]+" },
          { "pattern": "([?&](?:api[_-]?key|access[_-]?key|token|secret|password|signature|credential|authorization)=)[^&#\\s]+" },
          { "pattern": "[A-Za-z]:\\\\[^\\s\\\"'<>]+" },
          { "pattern": "\\/(?:home|Users|var|tmp)\\/[^\\s\\\"'<>]+" },
          { "pattern": "https?:\\/\\/[^\\s\\\"'<>]+" },
          { "pattern": "(?:file|s3|gs|ftp):\\/\\/[^\\s\\\"'<>]+" },
          { "pattern": "data:[^\\s\\\"'<>]+" }
        ]
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$" },
        "deliverableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "reviewerType": { "enum": ["manual", "vlm", "hybrid"] },
    "reviewStatus": { "enum": ["accepted", "needs_review", "rejected"] },
    "metricName": {
      "enum": [
        "script_video_fidelity",
        "user_demand_fulfillment",
        "temporal_coherence",
        "transition_quality",
        "lighting_consistency",
        "text_video_consistency"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricName", "evidenceSummary"],
      "oneOf": [
        { "required": ["score"] },
        { "required": ["likertScore"] }
      ],
      "properties": {
        "metricName": { "$ref": "#/$defs/metricName" },
        "status": { "$ref": "#/$defs/reviewStatus" },
        "reviewerType": { "$ref": "#/$defs/reviewerType" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "likertScore": { "type": "number", "minimum": 1, "maximum": 5 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceSummary": { "$ref": "#/$defs/safeReviewText" },
        "reviewedShotCount": { "type": "integer", "minimum": 0 },
        "reviewedBoundaryCount": { "type": "integer", "minimum": 0 },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/safeReviewText" } }
      }
    }
  }
}
