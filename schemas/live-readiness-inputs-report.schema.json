{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/live-readiness-inputs-report.schema.json",
  "title": "CineJelly Live Readiness Inputs Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "checkedInputs",
    "environment",
    "costPlan",
    "gates",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.live-readiness-inputs.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["blocked_by_missing_inputs", "ready_for_live_validation_sequence"]
    },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opsConfigPath",
        "atlasBillingPath",
        "generatedAudioAtlasBillingPath",
        "longFormAtlasBillingPath",
        "sourceVideoAtlasBillingPath",
        "launchIntakePath",
        "launchIntakePresent",
        "launchIntakeStatus",
        "launchIntakeApplied",
        "billingAttestationPath",
        "productionAttestationPath",
        "deploymentBaseUrlConfigured",
        "sourceVideoUrlConfigured",
        "maxBudgetUsd",
        "longFormDurationSeconds",
        "generatedAudioTextCharacterCount"
      ],
      "properties": {
        "opsConfigPath": { "type": "string" },
        "atlasBillingPath": { "type": "string" },
        "generatedAudioAtlasBillingPath": { "type": "string" },
        "longFormAtlasBillingPath": { "type": "string" },
        "sourceVideoAtlasBillingPath": { "type": "string" },
        "launchIntakePath": { "type": "string" },
        "launchIntakePresent": { "type": "boolean" },
        "launchIntakeStatus": { "type": "string" },
        "launchIntakeApplied": { "type": "boolean" },
        "billingAttestationPath": { "type": "string" },
        "productionAttestationPath": { "type": "string" },
        "deploymentBaseUrlConfigured": { "type": "boolean" },
        "sourceVideoUrlConfigured": { "type": "boolean" },
        "maxBudgetUsd": { "type": "number", "minimum": 0 },
        "longFormDurationSeconds": { "type": "integer", "minimum": 120, "maximum": 480 },
        "generatedAudioTextCharacterCount": { "type": "integer", "minimum": 0 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["launchIntake", "atlas", "deployment", "operations", "atlasBilling", "sourceVideo", "remoteStock", "generatedAudio"]
    },
    "costPlan": {
      "type": "object",
      "additionalProperties": true,
      "required": ["maxBudgetUsd", "knownPaidEstimateUsd", "budgetFit", "longForm", "generatedAudio", "unknownCostItems"],
      "properties": {
        "maxBudgetUsd": { "type": "number", "minimum": 0 },
        "knownPaidEstimateUsd": { "type": "number", "minimum": 0 },
        "budgetFit": { "enum": ["within_budget", "exceeds_budget", "unknown"] },
        "unknownCostItems": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "status", "checks"],
        "properties": {
          "name": { "type": "string" },
          "kind": {
            "enum": ["no_spend", "no_spend_network", "live_network", "paid_atlas_llm_and_source_fetch", "paid_atlas_audio", "paid_atlas_video"]
          },
          "status": { "enum": ["ready", "blocked"] },
          "estimatedCostUsd": { "type": "number", "minimum": 0 },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "status", "message"],
              "properties": {
                "name": { "type": "string" },
                "status": { "enum": ["pass", "fail"] },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canRunDeploymentReadinessCapture",
        "canRunBillingAdminOpsCapture",
        "canRunProductionOpsCapture",
        "canRunSourceVideoPaidValidation",
        "canRunRemoteStockProviderValidation",
        "canRunGeneratedAudioPaidValidation",
        "canRunLongFormWithinBudget",
        "readyPaidGates",
        "readyPaidGateCount",
        "shouldDeferFullSequenceSpend",
        "shouldDeferAtlasSpend",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "canRunDeploymentReadinessCapture": { "type": "boolean" },
        "canRunBillingAdminOpsCapture": { "type": "boolean" },
        "canRunProductionOpsCapture": { "type": "boolean" },
        "canRunSourceVideoPaidValidation": { "type": "boolean" },
        "canRunRemoteStockProviderValidation": { "type": "boolean" },
        "canRunGeneratedAudioPaidValidation": { "type": "boolean" },
        "canRunLongFormWithinBudget": { "type": "boolean" },
        "readyPaidGates": { "type": "array", "items": { "type": "string" } },
        "readyPaidGateCount": { "type": "integer", "minimum": 0 },
        "shouldDeferFullSequenceSpend": { "type": "boolean" },
        "shouldDeferAtlasSpend": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "type": "boolean" },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error": { "type": "string" }
  }
}
