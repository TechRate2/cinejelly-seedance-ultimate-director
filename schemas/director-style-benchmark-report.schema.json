{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/director-style-benchmark-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "summary",
    "facts",
    "dimensionScores",
    "metrics",
    "bottlenecks",
    "parityEvidenceMatrix",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.director-style-benchmark.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "review_required", "blocked"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "minPassingScore", "minConfidence"],
      "properties": {
        "profile": { "enum": ["balanced", "story_first", "visual_heavy", "audio_emotion", "sync_perfectionist"] },
        "sourceReportPath": { "type": "string", "minLength": 1 },
        "requestPath": { "type": "string", "minLength": 1 },
        "artifactDirectory": { "type": "string", "minLength": 1 },
        "mediaPath": { "type": "string", "minLength": 1 },
        "frameSamplingIntervalSeconds": { "type": "integer", "minimum": 1 },
        "maxFrameSamples": { "type": "integer", "minimum": 0 },
        "sceneChangeThreshold": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "transitionBoundaryWindowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxTransitionBoundaries": { "type": "integer", "minimum": 0 },
        "semanticReviewPath": { "type": "string", "minLength": 1 },
        "audioReviewPath": { "type": "string", "minLength": 1 },
        "runtimeReviewPath": { "type": "string", "minLength": 1 },
        "governanceReviewPath": { "type": "string", "minLength": 1 },
        "generatedAudioValidationPath": { "type": "string", "minLength": 1 },
        "longFormValidationPath": { "type": "string", "minLength": 1 },
        "outputPath": { "type": "string", "minLength": 1 },
        "jsonlPath": { "type": "string", "minLength": 1 },
        "minPassingScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "evidenceScope",
        "metricCount",
        "scoredMetricCount",
        "skippedMetricCount",
        "bottleneckCount",
        "lowConfidenceMetricCount",
        "canClaimDirectorBenchParity"
      ],
      "properties": {
        "overallScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "overallConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "grade": { "enum": ["A", "B", "C", "D", "F", "N/A"] },
        "evidenceScope": {
          "enum": [
            "artifact_contract_only",
            "artifact_contract_plus_media_probe",
            "artifact_contract_plus_media_frames",
            "artifact_contract_plus_media_boundaries",
            "artifact_contract_plus_media_audio_waveform",
            "artifact_contract_plus_semantic_review",
            "artifact_contract_plus_semantic_audio_review",
            "artifact_contract_plus_media_semantic_review",
            "artifact_contract_plus_media_semantic_audio_waveform",
            "artifact_contract_plus_audio_review",
            "artifact_contract_plus_media_audio_review",
            "artifact_contract_plus_media_semantic_audio_review",
            "artifact_contract_plus_runtime_review",
            "artifact_contract_plus_media_runtime_review",
            "artifact_contract_plus_semantic_audio_runtime_review",
            "artifact_contract_plus_media_semantic_audio_runtime_review"
          ]
        },
        "metricCount": { "type": "integer", "minimum": 1 },
        "scoredMetricCount": { "type": "integer", "minimum": 0 },
        "skippedMetricCount": { "type": "integer", "minimum": 0 },
        "bottleneckCount": { "type": "integer", "minimum": 0 },
        "lowConfidenceMetricCount": { "type": "integer", "minimum": 0 },
        "canClaimDirectorBenchParity": { "const": false }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasAudioEvidence", "manualReviewProvided", "manualReviewAccepted", "artifactKinds", "sourcePatternOrigins"],
      "properties": {
        "sourceReportPath": { "type": "string", "minLength": 1 },
        "requestPath": { "type": "string", "minLength": 1 },
        "artifactDirectory": { "type": "string", "minLength": 1 },
        "renderStatus": { "type": "string" },
        "readinessDecision": { "type": "string" },
        "artifactValidationStatus": { "type": "string" },
        "projectId": { "type": "string" },
        "requestId": { "type": "string" },
        "targetDurationSeconds": { "type": "number", "minimum": 0 },
        "finalDurationSeconds": { "type": "number", "minimum": 0 },
        "hasAudioEvidence": { "type": "boolean" },
        "manualReviewProvided": { "type": "boolean" },
        "manualReviewAccepted": { "type": "boolean" },
        "costLedgerEntryCount": { "type": "integer", "minimum": 0 },
        "artifactKinds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sourcePatternOrigins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mediaEvidence": { "$ref": "#/$defs/mediaEvidence" },
        "semanticReviewEvidence": { "$ref": "#/$defs/semanticReviewEvidence" },
        "audioReviewEvidence": { "$ref": "#/$defs/audioReviewEvidence" },
        "runtimeReviewEvidence": { "$ref": "#/$defs/runtimeReviewEvidence" },
        "governanceReviewEvidence": { "$ref": "#/$defs/governanceReviewEvidence" },
        "generatedAudioProviderEvidence": { "$ref": "#/$defs/generatedAudioProviderEvidence" },
        "longFormValidationEvidence": { "$ref": "#/$defs/longFormValidationEvidence" }
      }
    },
    "dimensionScores": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/dimensionScore" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric" }
    },
    "bottlenecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/bottleneck" }
    },
    "parityEvidenceMatrix": { "$ref": "#/$defs/parityEvidenceMatrix" },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarkHarnessPass",
        "canUseAsBackendBenchmarkEvidence",
        "canClaimDirectorBenchParity",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "benchmarkHarnessPass": { "type": "boolean" },
        "canUseAsBackendBenchmarkEvidence": { "type": "boolean" },
        "canClaimDirectorBenchParity": { "const": false },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string", "minLength": 1 }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "dimension": { "enum": ["script", "video", "audio", "stability", "cross_modal"] },
    "metricStatus": { "enum": ["pass", "warn", "fail", "skipped"] },
    "severity": { "enum": ["info", "warn", "block"] },
    "parityEvidenceStatus": { "enum": ["met", "partial", "missing"] },
    "reviewArtifactBindingStatus": { "enum": ["matched", "missing", "mismatched"] },
    "reviewArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "deliverableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "parityEvidenceCategory": {
      "enum": [
        "artifact_contract",
        "visual_media",
        "audio_media",
        "long_form",
        "semantic_review",
        "runtime_parity",
        "governance"
      ]
    },
    "mediaStreamEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codecName": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameRate": { "type": "number", "minimum": 0 },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "channelCount": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "audioWaveformSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "analyzer", "findings"],
      "properties": {
        "status": { "enum": ["analyzed", "unavailable"] },
        "analyzer": { "const": "ffmpeg_volumedetect" },
        "analyzedDurationSeconds": { "type": "number", "minimum": 0 },
        "meanVolumeDb": { "type": "number" },
        "maxVolumeDb": { "type": "number" },
        "headroomDb": { "type": "number", "minimum": 0 },
        "signalPresenceScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "audioVideoSyncSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "analyzer", "findings"],
      "properties": {
        "status": { "enum": ["analyzed", "unavailable"] },
        "analyzer": { "const": "ffprobe_duration_delta" },
        "containerDurationSeconds": { "type": "number", "minimum": 0 },
        "videoDurationSeconds": { "type": "number", "minimum": 0 },
        "audioDurationSeconds": { "type": "number", "minimum": 0 },
        "durationDeltaSeconds": { "type": "number", "minimum": 0 },
        "durationDeltaRatio": { "type": "number", "minimum": 0 },
        "durationAlignmentScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "audioMediaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasAudio"],
      "properties": {
        "hasAudio": { "type": "boolean" },
        "codecName": { "type": "string", "minLength": 1 },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "channelCount": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "waveformSignals": { "$ref": "#/$defs/audioWaveformSignals" },
        "audioVideoSyncSignals": { "$ref": "#/$defs/audioVideoSyncSignals" }
      }
    },
    "visualSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "findings"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 0 },
        "meanBrightness": { "type": "number", "minimum": 0, "maximum": 1 },
        "brightnessRange": { "type": "number", "minimum": 0, "maximum": 1 },
        "brightnessStdDev": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanColorDelta": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxColorDelta": { "type": "number", "minimum": 0, "maximum": 1 },
        "temporalContinuityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "lightingConsistencyScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "transitionContinuityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "mediaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "findings"],
      "properties": {
        "status": { "enum": ["unavailable", "probe_only", "frame_sampled"] },
        "source": { "const": "local_file" },
        "mediaPath": { "type": "string", "minLength": 1 },
        "mediaFileName": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "deliveryStatus": { "enum": ["pass", "warn", "fail"] },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "bitrate": { "type": "integer", "minimum": 0 },
        "video": { "$ref": "#/$defs/mediaStreamEvidence" },
        "audio": { "$ref": "#/$defs/audioMediaEvidence" },
        "frameSampleCount": { "type": "integer", "minimum": 0 },
        "frameSamplingIntervalSeconds": { "type": "integer", "minimum": 1 },
        "sampledFramesRedacted": { "const": true },
        "visualSignals": { "$ref": "#/$defs/visualSignals" },
        "transitionSignals": { "$ref": "#/$defs/transitionSignals" },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "transitionBoundarySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "timeSeconds",
        "preTimeSeconds",
        "postTimeSeconds",
        "colorDelta",
        "brightnessDelta",
        "continuityScore"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "timeSeconds": { "type": "number", "minimum": 0 },
        "preTimeSeconds": { "type": "number", "minimum": 0 },
        "postTimeSeconds": { "type": "number", "minimum": 0 },
        "colorDelta": { "type": "number", "minimum": 0, "maximum": 1 },
        "brightnessDelta": { "type": "number", "minimum": 0, "maximum": 1 },
        "continuityScore": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "transitionSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sceneChangeThreshold",
        "boundaryWindowSeconds",
        "candidateBoundaryCount",
        "analyzedBoundaryCount",
        "findings"
      ],
      "properties": {
        "status": { "enum": ["not_detected", "analyzed", "unavailable"] },
        "sceneChangeThreshold": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "boundaryWindowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "candidateBoundaryCount": { "type": "integer", "minimum": 0 },
        "analyzedBoundaryCount": { "type": "integer", "minimum": 0 },
        "meanBoundaryColorDelta": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxBoundaryColorDelta": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanBrightnessDelta": { "type": "number", "minimum": 0, "maximum": 1 },
        "transitionContinuityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "boundaries": { "type": "array", "items": { "$ref": "#/$defs/transitionBoundarySignal" } },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "semanticReviewMetricName": {
      "enum": [
        "script_video_fidelity",
        "user_demand_fulfillment",
        "temporal_coherence",
        "transition_quality",
        "lighting_consistency",
        "text_video_consistency"
      ]
    },
    "semanticReviewStatus": { "enum": ["accepted", "needs_review", "rejected"] },
    "semanticReviewerType": { "enum": ["manual", "vlm", "hybrid"] },
    "semanticReviewMetricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricName",
        "status",
        "reviewerType",
        "score",
        "confidence",
        "evidenceSummary",
        "findings"
      ],
      "properties": {
        "metricName": { "$ref": "#/$defs/semanticReviewMetricName" },
        "status": { "$ref": "#/$defs/semanticReviewStatus" },
        "reviewerType": { "$ref": "#/$defs/semanticReviewerType" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceSummary": { "type": "string", "minLength": 1 },
        "reviewedShotCount": { "type": "integer", "minimum": 0 },
        "reviewedBoundaryCount": { "type": "integer", "minimum": 0 },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "semanticReviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "reviewerType",
        "metricCount",
        "metrics",
        "findings"
      ],
      "properties": {
        "source": { "enum": ["manual_json", "vlm_json", "hybrid_json"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/semanticReviewStatus" },
        "reviewerType": { "$ref": "#/$defs/semanticReviewerType" },
        "artifactBinding": { "$ref": "#/$defs/reviewArtifactBinding" },
        "artifactBindingStatus": { "$ref": "#/$defs/reviewArtifactBindingStatus" },
        "reviewedShotCount": { "type": "integer", "minimum": 0 },
        "reviewedBoundaryCount": { "type": "integer", "minimum": 0 },
        "metricCount": { "type": "integer", "minimum": 1 },
        "averageScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "averageConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/semanticReviewMetricEvidence" }
        },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "audioReviewMetricName": {
      "enum": [
        "narration_reasonableness",
        "bgm_consistency",
        "video_audio_consistency",
        "text_audio_consistency"
      ]
    },
    "audioReviewStatus": { "enum": ["accepted", "needs_review", "rejected"] },
    "audioReviewerType": { "enum": ["manual", "asr", "waveform", "hybrid"] },
    "audioReviewMetricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricName",
        "status",
        "reviewerType",
        "score",
        "confidence",
        "evidenceSummary",
        "findings"
      ],
      "properties": {
        "metricName": { "$ref": "#/$defs/audioReviewMetricName" },
        "status": { "$ref": "#/$defs/audioReviewStatus" },
        "reviewerType": { "$ref": "#/$defs/audioReviewerType" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceSummary": { "type": "string", "minLength": 1 },
        "reviewedSegmentCount": { "type": "integer", "minimum": 0 },
        "reviewedBoundaryCount": { "type": "integer", "minimum": 0 },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "audioReviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "reviewerType",
        "metricCount",
        "metrics",
        "findings"
      ],
      "properties": {
        "source": { "enum": ["manual_json", "asr_json", "waveform_json", "hybrid_json"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/audioReviewStatus" },
        "reviewerType": { "$ref": "#/$defs/audioReviewerType" },
        "artifactBinding": { "$ref": "#/$defs/reviewArtifactBinding" },
        "artifactBindingStatus": { "$ref": "#/$defs/reviewArtifactBindingStatus" },
        "reviewedSegmentCount": { "type": "integer", "minimum": 0 },
        "reviewedBoundaryCount": { "type": "integer", "minimum": 0 },
        "metricCount": { "type": "integer", "minimum": 1 },
        "averageScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "averageConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/audioReviewMetricEvidence" }
        },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "runtimeReviewMetricName": {
      "enum": [
        "asr_transcript_alignment",
        "lip_sync_timing"
      ]
    },
    "runtimeReviewStatus": { "enum": ["accepted", "needs_review", "rejected"] },
    "runtimeReviewerType": { "enum": ["manual", "asr", "lip_sync", "hybrid"] },
    "runtimeReviewMetricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricName",
        "status",
        "reviewerType",
        "score",
        "confidence",
        "evidenceSummary",
        "findings"
      ],
      "properties": {
        "metricName": { "$ref": "#/$defs/runtimeReviewMetricName" },
        "status": { "$ref": "#/$defs/runtimeReviewStatus" },
        "reviewerType": { "$ref": "#/$defs/runtimeReviewerType" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceSummary": { "type": "string", "minLength": 1 },
        "reviewedSegmentCount": { "type": "integer", "minimum": 0 },
        "reviewedBoundaryCount": { "type": "integer", "minimum": 0 },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "runtimeReviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "reviewerType",
        "metricCount",
        "metrics",
        "findings"
      ],
      "properties": {
        "source": { "enum": ["manual_runtime_json", "asr_json", "lip_sync_json", "hybrid_runtime_json"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/runtimeReviewStatus" },
        "reviewerType": { "$ref": "#/$defs/runtimeReviewerType" },
        "artifactBinding": { "$ref": "#/$defs/reviewArtifactBinding" },
        "artifactBindingStatus": { "$ref": "#/$defs/reviewArtifactBindingStatus" },
        "reviewedSegmentCount": { "type": "integer", "minimum": 0 },
        "reviewedBoundaryCount": { "type": "integer", "minimum": 0 },
        "metricCount": { "type": "integer", "minimum": 1 },
        "averageScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "averageConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runtimeReviewMetricEvidence" }
        },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "governanceReviewCheckEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkName", "status", "reviewerType", "evidenceSummary", "findings"],
      "properties": {
        "checkName": {
          "enum": [
            "directorbench_license_boundary",
            "upstream_code_reuse_boundary",
            "runtime_evaluator_independence",
            "evaluation_asset_permissions"
          ]
        },
        "status": { "enum": ["accepted", "needs_review", "rejected"] },
        "reviewerType": { "enum": ["operator", "legal", "product", "security", "hybrid"] },
        "evidenceSummary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "governanceReviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "status", "reviewerType", "checkCount", "acceptedCheckCount", "checks", "findings"],
      "properties": {
        "source": {
          "enum": [
            "operator_governance_json",
            "legal_governance_json",
            "product_governance_json",
            "security_governance_json",
            "hybrid_governance_json"
          ]
        },
        "sourcePath": { "type": "string", "minLength": 1 },
        "status": { "enum": ["accepted", "needs_review", "rejected"] },
        "reviewerType": { "enum": ["operator", "legal", "product", "security", "hybrid"] },
        "artifactBinding": { "$ref": "#/$defs/reviewArtifactBinding" },
        "artifactBindingStatus": { "$ref": "#/$defs/reviewArtifactBindingStatus" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "checkCount": { "type": "integer", "minimum": 1 },
        "acceptedCheckCount": { "type": "integer", "minimum": 0 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/governanceReviewCheckEvidence" }
        },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "generatedAudioProviderEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "reportStatus",
        "canUseAsBusinessReadinessGeneratedAudioEvidence",
        "providerNetworkCallsAllowed",
        "atlasBillingReady",
        "schemaReviewed",
        "approvedTrackCount",
        "providerLedgerEntryCount",
        "manualReviewPassed",
        "artifactEvidenceChecked",
        "artifactEvidenceMatchesReport",
        "findings"
      ],
      "properties": {
        "source": { "const": "generated_audio_validation_report" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "status": { "enum": ["accepted", "needs_review", "rejected"] },
        "reportStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "canUseAsBusinessReadinessGeneratedAudioEvidence": { "type": "boolean" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "outputFormat": { "enum": ["mp3", "wav"] },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "estimatedCostUsd": { "type": "number", "minimum": 0 },
        "providerNetworkCallsAllowed": { "type": "boolean" },
        "atlasBillingReady": { "type": "boolean" },
        "schemaReviewed": { "type": "boolean" },
        "executionStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "outputBatchStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "approvedTrackCount": { "type": "integer", "minimum": 0 },
        "providerLedgerEntryCount": { "type": "integer", "minimum": 0 },
        "manualReviewPassed": { "type": "boolean" },
        "artifactEvidenceChecked": { "type": "boolean" },
        "artifactEvidenceMatchesReport": { "type": "boolean" },
        "artifactEvidenceReportPath": { "type": "string", "minLength": 1, "maxLength": 240 },
        "mediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "longFormValidationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "reportStatus",
        "canUseAsBusinessReadinessLongFormEvidence",
        "providerSpendAllowed",
        "atlasBillingReady",
        "artifactEvidencePresent",
        "deliverablePresent",
        "costLedgerEntryCount",
        "manualQualityReviewPassed",
        "manualReviewArtifactBindingMatched",
        "findings"
      ],
      "properties": {
        "source": { "const": "long_form_validation_report" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "status": { "enum": ["accepted", "needs_review", "rejected"] },
        "reportStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "canUseAsBusinessReadinessLongFormEvidence": { "type": "boolean" },
        "plannedDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "finalDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "providerSpendAllowed": { "type": "boolean" },
        "atlasBillingReady": { "type": "boolean" },
        "requestValidationStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "readinessDecision": { "type": "string", "minLength": 1, "maxLength": 80 },
        "chunkPlanStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "paidRenderStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "artifactValidationStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "artifactEvidencePresent": { "type": "boolean" },
        "deliverablePresent": { "type": "boolean" },
        "costLedgerEntryCount": { "type": "integer", "minimum": 0 },
        "manualQualityReviewPassed": { "type": "boolean" },
        "manualReviewArtifactBindingMatched": { "type": "boolean" },
        "manualReviewArtifactBindingStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "severity", "message"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "dimensionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "weight", "metricCount", "skippedMetricCount", "status"],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "metricCount": { "type": "integer", "minimum": 0 },
        "skippedMetricCount": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/metricStatus" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "metricName",
        "upstreamMetric",
        "status",
        "evidence",
        "suggestions",
        "limitations"
      ],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "metricName": { "type": "string", "minLength": 1 },
        "upstreamMetric": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/metricStatus" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "suggestions": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bottleneck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "metricName", "severity", "message", "suggestions"],
      "properties": {
        "dimension": { "$ref": "#/$defs/dimension" },
        "metricName": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string", "minLength": 1 },
        "suggestions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "parityEvidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "status",
        "requiredForDirectorBenchParity",
        "evidence",
        "missingEvidence",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/parityEvidenceCategory" },
        "status": { "$ref": "#/$defs/parityEvidenceStatus" },
        "requiredForDirectorBenchParity": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "missingEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "parityEvidenceMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementCount",
        "metCount",
        "partialCount",
        "missingCount",
        "requiredForParityCount",
        "requiredForParityMetCount",
        "canClaimDirectorBenchParity",
        "requirements"
      ],
      "properties": {
        "requirementCount": { "type": "integer", "minimum": 1 },
        "metCount": { "type": "integer", "minimum": 0 },
        "partialCount": { "type": "integer", "minimum": 0 },
        "missingCount": { "type": "integer", "minimum": 0 },
        "requiredForParityCount": { "type": "integer", "minimum": 1 },
        "requiredForParityMetCount": { "type": "integer", "minimum": 0 },
        "canClaimDirectorBenchParity": { "const": false },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parityEvidenceRequirement" }
        }
      }
    }
  }
}
