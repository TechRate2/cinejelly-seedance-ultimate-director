{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/short-agent-graph-smoke-report.schema.json",
  "title": "CineJelly Short Agent Graph Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "graphSummary",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.short-agent-graph-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputPath",
        "targetDurationSeconds",
        "sceneCount",
        "candidateCount",
        "promptShotCount",
        "durationProductionContractPresent",
        "audioScriptLineCount",
        "hybridAudioDefault",
        "selectedCreativeIdeaCandidatePresent",
        "rawSourceLeakCheckPassed"
      ],
      "properties": {
        "outputPath": { "type": "string" },
        "targetDurationSeconds": { "type": "integer", "minimum": 8, "maximum": 60 },
        "sceneCount": { "type": "integer", "minimum": 3 },
        "candidateCount": { "type": "integer", "minimum": 4 },
        "promptShotCount": { "type": "integer", "minimum": 3 },
        "durationProductionContractPresent": { "const": true },
        "audioScriptLineCount": { "type": "integer", "minimum": 3 },
        "hybridAudioDefault": { "const": true },
        "selectedCreativeIdeaCandidatePresent": { "const": true },
        "rawSourceLeakCheckPassed": { "const": true }
      }
    },
    "graphSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphRunId",
        "graphStatus",
        "selectedCandidateId",
        "researchQuestionCount",
        "evidenceCount",
        "memoryPatternCount",
        "critiqueCount",
        "repairCount",
        "selectedCreativeIdeaId",
        "selectedCandidateLabel",
        "promptPackId",
        "durationProductionTimingRisk",
        "audioScriptExternalTtsReady",
        "handoffAudioMode",
        "handoffHasPromptPack"
      ],
      "properties": {
        "graphRunId": { "type": "string" },
        "graphStatus": { "enum": ["ready", "review_required", "blocked"] },
        "selectedCandidateId": { "type": "string" },
        "researchQuestionCount": { "type": "integer", "minimum": 5 },
        "evidenceCount": { "type": "integer", "minimum": 1 },
        "memoryPatternCount": { "type": "integer", "minimum": 3 },
        "critiqueCount": { "type": "integer", "minimum": 0 },
        "repairCount": { "type": "integer", "minimum": 0 },
        "selectedCreativeIdeaId": { "type": "string" },
        "selectedCandidateLabel": { "type": "string" },
        "promptPackId": { "type": "string" },
        "durationProductionTimingRisk": { "enum": ["low", "medium", "high", "missing"] },
        "audioScriptExternalTtsReady": { "const": true },
        "handoffAudioMode": { "enum": ["hybrid", "native", "guided", "none"] },
        "handoffHasPromptPack": { "const": true }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canUseAsNoSpendShortAgentEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "canUseAsNoSpendShortAgentEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
