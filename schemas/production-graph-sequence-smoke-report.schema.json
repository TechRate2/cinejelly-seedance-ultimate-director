{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/production-graph-sequence-smoke-report.schema.json",
  "title": "CineJelly Production Graph Sequence Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "scenarios",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.production-graph-sequence-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "scenarioCount", "expectedHierarchy"],
      "properties": {
        "outputPath": { "type": "string", "minLength": 1 },
        "scenarioCount": { "type": "integer", "minimum": 3 },
        "expectedHierarchy": { "const": "project -> story_arc -> sequence -> scene -> beat -> shot" }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleScene", "twoMinute", "eightMinute"],
      "properties": {
        "singleScene": { "$ref": "#/$defs/scenario" },
        "twoMinute": { "$ref": "#/$defs/scenario" },
        "eightMinute": { "$ref": "#/$defs/scenario" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/check" }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canUseAsNoSpendLongFormSequenceGraphEvidence",
        "canReleaseToCustomerTraffic",
        "releaseBlocker"
      ],
      "properties": {
        "canUseAsNoSpendLongFormSequenceGraphEvidence": { "type": "boolean" },
        "canReleaseToCustomerTraffic": { "const": false },
        "releaseBlocker": { "type": "string", "minLength": 1 }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetDurationSeconds",
        "sceneCount",
        "sequenceCount",
        "expectedShotCount",
        "shotCount",
        "beatCount",
        "directStoryToSceneEdgeCount",
        "everySceneHasSequenceParent",
        "everySequenceHasStoryParent",
        "sequenceOrdersContiguous",
        "sceneOrdersContiguous",
        "sequenceCountWithinDocumentedRange",
        "hierarchySummary"
      ],
      "properties": {
        "targetDurationSeconds": { "type": "number", "minimum": 1 },
        "sceneCount": { "type": "integer", "minimum": 1 },
        "sequenceCount": { "type": "integer", "minimum": 1 },
        "expectedShotCount": { "type": "integer", "minimum": 1 },
        "shotCount": { "type": "integer", "minimum": 1 },
        "beatCount": { "type": "integer", "minimum": 1 },
        "directStoryToSceneEdgeCount": { "type": "integer", "minimum": 0 },
        "everySceneHasSequenceParent": { "type": "boolean" },
        "everySequenceHasStoryParent": { "type": "boolean" },
        "sequenceOrdersContiguous": { "type": "boolean" },
        "sceneOrdersContiguous": { "type": "boolean" },
        "sequenceCountWithinDocumentedRange": { "type": "boolean" },
        "hierarchySummary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storyArcCount", "sequenceIds", "sceneIds"],
          "properties": {
            "storyArcCount": { "type": "integer", "minimum": 1 },
            "sequenceIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "sceneIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
