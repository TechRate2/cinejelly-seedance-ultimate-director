{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinejelly.local/schemas/material-source-scoring-smoke-report.schema.json",
  "title": "CineJelly Material Source Scoring Smoke Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "noSpend",
    "networkCallsMade",
    "providerCallsMade",
    "sourcePatternOrigins",
    "checkedInputs",
    "materialValidation",
    "candidateEvaluations",
    "checks",
    "releaseGateSummary",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "cinejelly.material-source-scoring-smoke.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail"] },
    "noSpend": { "const": true },
    "networkCallsMade": { "const": false },
    "providerCallsMade": { "const": false },
    "sourcePatternOrigins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checkedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "syntheticBriefCount", "syntheticCandidateCount"],
      "properties": {
        "outputPath": { "type": "string" },
        "syntheticBriefCount": { "type": "integer", "minimum": 1 },
        "syntheticCandidateCount": { "type": "integer", "minimum": 1 }
      }
    },
    "materialValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "planId",
        "projectId",
        "candidateCount",
        "selectedCandidateCount",
        "approvedCandidateCount",
        "rejectedCandidateCount",
        "candidateEvaluationCount",
        "decisionCounts",
        "issueCounts",
        "issueCodeCounts",
        "minFitScore",
        "maxFitScore"
      ],
      "properties": {
        "status": { "enum": ["planned_only", "approved", "review_required", "rejected"] },
        "planId": { "type": "string" },
        "projectId": { "type": "string" },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "selectedCandidateCount": { "type": "integer", "minimum": 0 },
        "approvedCandidateCount": { "type": "integer", "minimum": 0 },
        "rejectedCandidateCount": { "type": "integer", "minimum": 0 },
        "candidateEvaluationCount": { "type": "integer", "minimum": 0 },
        "decisionCounts": { "$ref": "#/$defs/counts" },
        "issueCounts": { "$ref": "#/$defs/counts" },
        "issueCodeCounts": { "$ref": "#/$defs/counts" },
        "minFitScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxFitScore": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "candidateEvaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateEvaluation" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "releaseGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canUseAsMaterialScoringBackendEvidence",
        "canUseAsLiveRemoteStockEvidence",
        "releaseBlocker"
      ],
      "properties": {
        "canUseAsMaterialScoringBackendEvidence": { "type": "boolean" },
        "canUseAsLiveRemoteStockEvidence": { "const": false },
        "releaseBlocker": { "type": "string" }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "candidateEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "briefId",
        "source",
        "selected",
        "decision",
        "fitScore",
        "maxFitScore",
        "scoreFactors",
        "blockingIssueCodes",
        "warningIssueCodes",
        "recommendedAction"
      ],
      "properties": {
        "candidateId": { "type": "string" },
        "briefId": { "type": "string" },
        "source": {
          "enum": ["user_provided", "local_library", "pexels", "pixabay", "coverr", "paid_stock", "atlas_asset_library"]
        },
        "selected": { "type": "boolean" },
        "decision": { "enum": ["approved", "review_required", "rejected"] },
        "fitScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxFitScore": { "const": 100 },
        "scoreFactors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "score", "maxScore", "passed", "message"],
            "properties": {
              "name": { "type": "string" },
              "score": { "type": "number", "minimum": 0 },
              "maxScore": { "type": "number", "minimum": 0 },
              "passed": { "type": "boolean" },
              "message": { "type": "string" }
            }
          }
        },
        "blockingIssueCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warningIssueCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendedAction": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["pass", "fail"] },
        "message": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
