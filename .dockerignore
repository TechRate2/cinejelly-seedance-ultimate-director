# Keep secret material and operator evidence out of Docker build contexts.
.env
.env.*
!.env.production.template
*.pem
*.key
*.p8
*.p12
*.crt
*.cer
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk

# Local credentials and cloud provider state.
.aws/
.azure/
.gcloud/
.kube/
.docker/config.json
service-account*.json
credentials*.json
token*.json
secrets*.json
ops/*.json

# Dependency, build, and generated artifacts.
node_modules/
dist/
build/
coverage/
.cache/
.turbo/
.next/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated media and customer/operator artifacts.
assets/reference_inputs/*
assets/output_deliverables/*
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.mp3
*.wav
*.flac
*.aac

# Large source-review snapshots are not needed to build the runtime image.
external/

# Docs and local editor noise are not required by the runtime image.
docs/
.git/
.github/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
