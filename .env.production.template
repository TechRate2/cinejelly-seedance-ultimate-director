# CINEJELLY_MAX_AUDIO_TRACK_BYTES=268435456
# Short Studio storage defaults under CINEJELLY_OUTPUT_DIR. Override only when
# the deployment uses a separate durable volume for UI continuity state.
CINEJELLY_SHORT_PIPELINE_SESSION_STORE_PATH=assets/output_deliverables/short-pipeline-sessions.json
CINEJELLY_SHORT_CHANNEL_STYLE_LIBRARY_PATH=assets/output_deliverables/short-channel-styles.json
# CINEJELLY_SHORT_PIPELINE_SESSION_STORE_LIMIT=200
# CINEJELLY_SHORT_CHANNEL_STYLE_LIBRARY_LIMIT=200
# CINEJELLY_RENDER_PROVIDER_LEASE_PATH=assets/output_deliverables/render-provider-leases.json
