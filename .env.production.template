# CineJelly production environment template.
# Copy to .env locally and fill real secrets. Do not commit .env files.
# See docs/RUNNING_AND_MODEL_SETTINGS_GUIDE.md for setup details.

ATLASCLOUD_API_KEY=
ATLASCLOUD_LLM_API_KEY=

# Atlas docs split Coding Plan LLM traffic and pay-as-you-go media traffic.
# Keep these as canonical defaults unless you are routing through a vetted HTTPS proxy.
ATLASCLOUD_LLM_BASE_URL=https://api.atlascloud.ai/v1
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1
# Optional aliases supported by the runtime. Leave commented unless a vetted Atlas
# endpoint/proxy requires these names instead of the canonical keys above.
# ATLASCLOUD_API_BASE_URL=https://api.atlascloud.ai/v1
# ATLASCLOUD_MEDIA_BASE_URL=https://api.atlascloud.ai/api/v1
# ATLASCLOUD_ASSET_BASE_URL=https://api.atlascloud.ai/api/v1

# Verify current model IDs in the Atlas Cloud model catalog before customer release.
ATLASCLOUD_LLM_MODEL=qwen/qwen3-vl-30b-a3b-thinking
ATLASCLOUD_SEEDANCE_MINI_MODEL=bytedance/seedance-2.0-mini/reference-to-video
ATLASCLOUD_SEEDANCE_STANDARD_MODEL=bytedance/seedance-2.0/reference-to-video
ATLASCLOUD_SEEDANCE_FAST_MODEL=bytedance/seedance-2.0-fast/reference-to-video

# Optional still-image model for keyframe-first generation (opening frames before video).
# Verify the exact image model ID in the Atlas Cloud catalog before enabling.
# ATLASCLOUD_IMAGE_MODEL=bytedance/seedream-4.0/text-to-image

# Optional Atlas generated-audio/TTS validation settings. These are not secrets.
# Verify the model page, voice ID, and pricing before customer release.
# ATLASCLOUD_GENERATED_AUDIO_MODEL=xai/tts-v1
# ATLASCLOUD_GENERATED_AUDIO_VOICE_ID=mai
# ATLASCLOUD_GENERATED_AUDIO_COST_USD_PER_1K_CHARS=0.015
# ATLASCLOUD_GENERATED_AUDIO_CAPABILITIES_JSON=[{"provider":"atlascloud","modelId":"xai/tts-v1","kinds":["tts_narration"],"outputFormats":["mp3","wav"],"maxDurationSeconds":120,"async":true}]

# Generate a random local token. This is not provided by Atlas.
CINEJELLY_API_AUTH_TOKEN=

# Real production mode keeps API auth and render rate limiting enabled.
# Do not set these to true outside a private local audit session.
# CINEJELLY_DISABLE_API_AUTH=false
# CINEJELLY_DISABLE_API_RATE_LIMIT=false

# Optional API/server capacity settings. Defaults are conservative for a small
# single-node launch; raise them only after provider budget and storage are ready.
# CINEJELLY_API_MAX_BODY_BYTES=1000000
# CINEJELLY_API_RATE_LIMIT_WINDOW_MS=60000
# CINEJELLY_API_RATE_LIMIT_MAX_REQUESTS=6
# CINEJELLY_API_SYNC_RENDER_CONCURRENCY=1
# CINEJELLY_API_JOB_CONCURRENCY=1
# CINEJELLY_API_JOB_HISTORY_LIMIT=100
# CINEJELLY_API_JOB_QUEUE_LIMIT=50

# Optional customer/client API policy.
# Store SHA-256 digests of customer API keys, not raw customer keys.
# Generate a digest locally with:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "customer-key"
# CINEJELLY_REQUIRE_CLIENT_POLICY_FOR_RENDER=false
# CINEJELLY_CLIENT_USAGE_LEDGER_PATH=assets/output_deliverables/client-usage/usage-ledger.jsonl
# CINEJELLY_API_JOB_HISTORY_PATH=assets/output_deliverables/render-jobs/job-history.json
# CINEJELLY_API_CLIENTS_JSON=[{"clientId":"customer-a","keySha256":"<64_hex_sha256>","enabled":true,"monthlyRequestLimit":25,"monthlyReservedCostUsdLimit":100,"maxReservedCostUsdPerRequest":10,"defaultReservedCostUsdPerRequest":3,"maxDurationTargetSeconds":120,"allowedTiers":["mini","fast","standard"],"allowedQualityModes":["economy","standard"]}]

# Optional workspace billing policy. Use this when multiple customers/workspaces
# share one deployment and each needs independent quotas or spend caps.
# CINEJELLY_REQUIRE_WORKSPACE_FOR_RENDER=false
# CINEJELLY_WORKSPACE_USAGE_LEDGER_PATH=assets/output_deliverables/workspace-usage/usage-ledger.jsonl
# CINEJELLY_WORKSPACES_JSON=[{"workspaceId":"workspace-a","enabled":true,"displayName":"Workspace A","planId":"pilot","clientIds":["customer-a"],"monthlyRequestLimit":50,"monthlyReservedCostUsdLimit":200,"maxReservedCostUsdPerRequest":10,"defaultReservedCostUsdPerRequest":3,"projects":[{"projectId":"brand-a","enabled":true}]}]

# Approved operator budget for live validation gates. Keep this at a small
# number until you explicitly approve a full paid Atlas validation sequence.
CINEJELLY_LIVE_VALIDATION_MAX_BUDGET_USD=5
CINEJELLY_ATLAS_BILLING_EVIDENCE_MAX_AGE_HOURS=24

# Optional local/container deployment settings.
# PORT=8787
# CINEJELLY_OUTPUT_DIR=assets/output_deliverables
# CINEJELLY_REQUEST_TIMEOUT_MS=120000
# CINEJELLY_POLLING_INTERVAL_MS=5000
# CINEJELLY_POLLING_TIMEOUT_MS=1800000
# CINEJELLY_ATLAS_JSON_RESPONSE_MAX_BYTES=8388608
# CINEJELLY_RENDER_CONCURRENCY=2
# CINEJELLY_MAX_RENDERED_CLIP_BYTES=2147483648
# CINEJELLY_MAX_AUDIO_TRACK_BYTES=268435456
# Short Studio storage defaults under CINEJELLY_OUTPUT_DIR. Override only when
# the deployment uses a separate durable volume for UI continuity state.
CINEJELLY_SHORT_PIPELINE_SESSION_STORE_PATH=assets/output_deliverables/short-pipeline-sessions.json
CINEJELLY_SHORT_CHANNEL_STYLE_LIBRARY_PATH=assets/output_deliverables/short-channel-styles.json
# CINEJELLY_SHORT_PIPELINE_SESSION_STORE_LIMIT=200
# CINEJELLY_SHORT_CHANNEL_STYLE_LIBRARY_LIMIT=200
# CINEJELLY_RENDER_PROVIDER_LEASE_PATH=assets/output_deliverables/render-provider-leases.json
# CINEJELLY_RENDER_PROVIDER_LEASE_MAX_RECORDS=500
# CINEJELLY_PRODUCTION_GRAPH_RESUME_QUEUE_PATH=assets/output_deliverables/production-graph-resume-queue.json
# CINEJELLY_PRODUCTION_GRAPH_RESUME_QUEUE_MAX_RECORDS=1000
# Container images default CINEJELLY_OUTPUT_DIR to /app/assets/output_deliverables.
# For commercial deployments, mount this path or override it to durable storage.
# docker-compose.yml publishes through Caddy. Set this to your real DNS hostname
# before running `docker compose up -d --build`; do not include https:// here.
CINEJELLY_PUBLIC_HOST=
# CINEJELLY_TRUST_PROXY_HEADERS=true

# Optional no-spend release evidence capture settings. These are used by validation scripts,
# not by the render runtime itself.
# CINEJELLY_DEPLOYMENT_BASE_URL=https://api.example.com
# CINEJELLY_DEPLOYMENT_API_AUTH_TOKEN=

# Set these if ffmpeg/ffprobe are installed but not available on PATH.
# CINEJELLY_FFMPEG_PATH=
# CINEJELLY_FFPROBE_PATH=

# Optional render/request admission limits. These protect API memory and provider
# spend from oversized user payloads while keeping defaults suitable for MVP.
# CINEJELLY_MAX_USER_INPUT_CHARS=24000
# CINEJELLY_MAX_REFERENCES=24
# CINEJELLY_MAX_CAPTION_CUES=600
# CINEJELLY_MAX_AUDIO_TRACKS=16
# CINEJELLY_MAX_GENERATED_AUDIO_INTENTS=32
# CINEJELLY_MAX_METADATA_ENTRIES=50
# CINEJELLY_MAX_SOURCE_VIDEO_SCENES=160
# CINEJELLY_MAX_SOURCE_VIDEO_TRANSCRIPT_CUES=1500
# CINEJELLY_MAX_SOURCE_VIDEO_KEYFRAMES_PER_SCENE=12
# CINEJELLY_MAX_SOURCE_VIDEO_NOTES=120

# Optional cost-estimation overrides. Keep unset unless Atlas pricing changes or
# you have verified a different internal margin model.
# CINEJELLY_RENDER_COST_USD_PER_SECOND=0
# CINEJELLY_ASSET_REGISTRATION_COST_USD=0
# CINEJELLY_LLM_PLAN_COST_USD=0
# CINEJELLY_COST_BUFFER_MULTIPLIER=1

# Optional source-video analysis. Disabled by default because it can fetch media,
# extract frames, and call Atlas LLM only after an explicit validation gate.
# CINEJELLY_ENABLE_SOURCE_VIDEO_AUTO_ANALYSIS=false
# CINEJELLY_SOURCE_VIDEO_ANALYSIS_WORK_DIR=assets/output_deliverables/source-video-analysis-work
# CINEJELLY_SOURCE_VIDEO_ANALYSIS_FRAME_INTERVAL_SECONDS=8
# CINEJELLY_SOURCE_VIDEO_ANALYSIS_MAX_FRAMES=12
# CINEJELLY_SOURCE_VIDEO_ANALYSIS_FAIL_ON_ERROR=false

# Optional material sourcing and generated-audio asset resolution. Remote stock
# stays disabled until provider terms and commercial-use approval are confirmed.
# CINEJELLY_LOCAL_MATERIAL_CATALOG_PATH=
# CINEJELLY_GENERATED_AUDIO_ASSET_RESOLUTION_CATALOG_PATH=
# CINEJELLY_ENABLE_REMOTE_STOCK_MATERIALS=false
# CINEJELLY_REMOTE_STOCK_REQUEST_TIMEOUT_MS=20000
# CINEJELLY_REMOTE_STOCK_MAX_RESULTS_PER_BRIEF=5
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# COVERR_API_KEY=
# CINEJELLY_COVERR_COMMERCIAL_USE_APPROVED=false

# setup:local writes documented Seedance capability assumptions automatically.
# Verify the current Atlas model catalog before customer release.
