# =============================================================================
# CineJelly — FILE CẤU HÌNH DUY NHẤT (dành cho người không rành code)
# =============================================================================
# CÁCH DÙNG (3 bước):
#   1) Sao chép file này thành file tên  .env  (cùng thư mục dự án).
#   2) Điền các dòng trong mục [BẮT BUỘC] bên dưới (API key của Atlas Cloud).
#   3) Chạy  npm run doctor  để hệ thống tự kiểm tra cấu hình cho bạn.
#
# QUY TẮC ĐỌC FILE:
#   - Dòng bắt đầu bằng dấu  #  là chú thích/tắt — hệ thống bỏ qua.
#   - Muốn BẬT một tùy chọn đang tắt: xóa dấu  #  ở đầu dòng rồi điền giá trị.
#   - KHÔNG chia sẻ file .env cho ai; không đưa lên GitHub (đã chặn sẵn).
#   - Không chắc một dòng nào đó? Cứ để nguyên — mặc định đã được chọn an toàn.
#
# BẢN ĐỒ CÁC MỤC:
#   [BẮT BUỘC]      : API key — không có là không chạy.
#   [MODEL]         : chọn "bộ não" và "máy quay" (đã điền sẵn, ít khi cần sửa).
#   [TÍNH NĂNG]     : ảnh keyframe, phụ đề từ giọng nói, đọc voice (bật khi cần).
#   [NÂNG CAO]      : giới hạn, hiệu năng, bảo mật — người mới KHÔNG cần động vào.
#
# Chi tiết kỹ thuật đầy đủ: docs/RUNNING_AND_MODEL_SETTINGS_GUIDE.md
# =============================================================================

# ------------------------- [BẮT BUỘC] API KEY --------------------------------
# Lấy key tại tài khoản Atlas Cloud của bạn. Dán vào sau dấu =, không có dấu cách.

ATLASCLOUD_API_KEY=
ATLASCLOUD_LLM_API_KEY=

# [BẮT BUỘC] Khóa quản trị của RIÊNG bạn — tự đặt một chuỗi ngẫu nhiên dài (32+ ký tự).
# Không có key này thì trang quản trị /operator/admin bị chặn (không duyệt nạp tiền được).
# Đây KHÔNG phải key của Atlas; bạn tự nghĩ ra và giữ bí mật.
CINEJELLY_API_AUTH_TOKEN=

# [BẮT BUỘC KHI BÁN] Thông tin chuyển khoản hiện cho khách khi nạp credits. Điền số tài
# khoản ngân hàng THẬT của bạn vào đây TRƯỚC khi cho khách nạp tiền — để nguyên mẫu bên
# dưới thì hệ thống chặn nạp tiền (báo lỗi rõ ràng) để tránh khách chuyển nhầm.
CINEJELLY_TOPUP_BANK_INFO=Chuyen khoan toi: (dien ngan hang + so tai khoan + ten chu TK). Noi dung CK: email tai khoan cua ban. Chuyen xong bam nut xac nhan, admin duyet trong it phut.

# Atlas docs split Coding Plan LLM traffic and pay-as-you-go media traffic.
# Keep these as canonical defaults unless you are routing through a vetted HTTPS proxy.
ATLASCLOUD_LLM_BASE_URL=https://api.atlascloud.ai/v1
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1
# Optional aliases supported by the runtime. Leave commented unless a vetted Atlas
# endpoint/proxy requires these names instead of the canonical keys above.
# ATLASCLOUD_API_BASE_URL=https://api.atlascloud.ai/v1
# ATLASCLOUD_MEDIA_BASE_URL=https://api.atlascloud.ai/api/v1
# ATLASCLOUD_ASSET_BASE_URL=https://api.atlascloud.ai/api/v1

# ------------------------- [MODEL] BỘ NÃO & MÁY QUAY -------------------------
# Đã điền sẵn model tốt. Chỉ đổi khi Atlas ra model mới (kiểm tra tên trong catalog).
# Verify current model IDs in the Atlas Cloud model catalog before customer release.
ATLASCLOUD_LLM_MODEL=qwen/qwen3-vl-30b-a3b-thinking
ATLASCLOUD_SEEDANCE_MINI_MODEL=bytedance/seedance-2.0-mini/reference-to-video
ATLASCLOUD_SEEDANCE_STANDARD_MODEL=bytedance/seedance-2.0/reference-to-video
ATLASCLOUD_SEEDANCE_FAST_MODEL=bytedance/seedance-2.0-fast/reference-to-video

# ------------------------- [TÍNH NĂNG] MỞ RỘNG -------------------------------
# (1) Ảnh keyframe trước khi quay (video đẹp/thật hơn rõ rệt). Bật = xóa dấu #.
# Optional still-image model for keyframe-first generation (opening frames before video).
# Verify the exact image model ID in the Atlas Cloud catalog before enabling.
# ATLASCLOUD_IMAGE_MODEL=bytedance/seedream-4.0/text-to-image

# (2) Phụ đề tự động từ file giọng nói người dùng (speech-to-text).
#     LƯU Ý: phụ đề cho voice do CineJelly tự đọc (TTS) KHÔNG cần bật mục này —
#     hệ thống sinh thẳng từ kịch bản, khớp 100% và không tốn phí.
# Optional speech-to-text model for subtitles from user-supplied audio.
# Verify the exact speech model ID in the Atlas Cloud catalog before enabling.
# BẮT BUỘC cho nút "🌐 Sub/Dub" (dịch phụ đề / thuyết minh video có sẵn, VD video tiếng
# Trung -> lồng tiếng Việt + phụ đề nhiều nước) — chưa điền thì nút này báo 503 rõ ràng
# và KHÔNG trừ tiền ai. Có thể bật/đổi ngay trên UI: Trung tâm quản trị -> Cài đặt -> Model.
# Phí khách mỗi lần dịch = giá 5 giây video (đổi theo CINEJELLY_CREDITS_PER_RENDER_SECOND);
# lỗi giữa chừng vào hàng chờ hoàn credits cho admin duyệt (chính sách mặc định manual).
# ATLASCLOUD_SPEECH_MODEL=openai/whisper-large-v3

# (3) Đọc voice tự động (TTS) — hệ thống tự đọc kịch bản thành giọng nói.
# Optional Atlas generated-audio/TTS validation settings. These are not secrets.
# Verify the model page, voice ID, and pricing before customer release.
# ATLASCLOUD_GENERATED_AUDIO_MODEL=xai/tts-v1
# ATLASCLOUD_GENERATED_AUDIO_VOICE_ID=mai
# ATLASCLOUD_GENERATED_AUDIO_COST_USD_PER_1K_CHARS=0.015
# ATLASCLOUD_GENERATED_AUDIO_CAPABILITIES_JSON=[{"provider":"atlascloud","modelId":"xai/tts-v1","kinds":["tts_narration"],"outputFormats":["mp3","wav"],"maxDurationSeconds":120,"async":true}]

# ------------------------- [NÂNG CAO] -----------------------------------------
# Từ đây trở xuống là bảo mật, giới hạn và hiệu năng. Mặc định đã an toàn —
# người mới KHÔNG cần chỉnh gì; chỉ sửa khi tài liệu vận hành yêu cầu.

# CINEJELLY_API_AUTH_TOKEN và CINEJELLY_TOPUP_BANK_INFO đã chuyển lên mục [BẮT BUỘC] ở đầu
# file (vì bắt buộc phải điền). Đừng khai lại ở đây để tránh trùng — điền một chỗ duy nhất.

# [KINH DOANH] Chinh sach hoan CREDITS khi video loi. LUU Y: tien mat KHONG BAO GIO tra ve
# khach o bat ky che do nao — day chi la credits (diem trong web). 3 lua chon:
#   manual = video loi vao hang cho de ban duyet tung ca (mac dinh, co loi cho ban).
#   auto   = tu dong tra credits ve vi khach khi video loi.
#   off    = KHONG tra credits khi video loi (credits bi tieu). Nen bat kem "treo cho admin"
#            (CINEJELLY_JOB_HOLD_ON_CONFIG_ERROR=true) de loi ha tang tu chay lai toi khi
#            xong thay vi tieu credits — nho vay credits chi mat o loi noi dung that su hiem.
# CINEJELLY_REFUND_POLICY=manual
#
# [KINH DOANH] Khach gui la chay thang (khong hien buoc ban duyet): khach bam tao video ->
# tru credits -> job chay ngay -> chi hien "dang hoan thien" -> tra video. Ban van xem/quan
# ly moi job trong /operator/admin. Dat "true" de bat. Mac dinh "false" (giu buoc duyet cho
# video dau, an toan chi phi hon). Bat cai nay nghia la khach tieu tien ngay khi bam tao.
# CINEJELLY_CUSTOMER_AUTO_RUN=true
#
# [KINH DOANH] "Treo cho admin": khi job loi vi phia he thong (thieu API key, model sai,
# nha cung cap loi...), job KHONG bao loi cho khach — khach chi thay "dang xu ly", tien van
# giu — va he thong tu thu lai; ban vao /operator/admin muc "Video dang treo" de sua roi bam
# "Thu lai ngay". Mac dinh BAT. Dat "false" de quay lai kieu cu (loi la fail + hoan tien ngay).
# CINEJELLY_JOB_HOLD_ON_CONFIG_ERROR=true
# So gio toi da mot job duoc treo truoc khi tu dong fail + hoan tien (chong ket tien vo han):
# CINEJELLY_JOB_HOLD_MAX_HOURS=24
# Bao lau he thong tu thu lai cac job dang treo (mili-giay), mac dinh 3 phut:
# CINEJELLY_JOB_HOLD_RETRY_INTERVAL_MS=180000
#
# [NANG CAO] Toan bo gia/goi/model/bank/noi dung deu chinh duoc qua UI admin va luu tai:
# CINEJELLY_ADMIN_SETTINGS_PATH=assets/output_deliverables/admin-settings.json

# Real production mode keeps API auth and render rate limiting enabled.
# Do not set these to true outside a private local audit session.
# CINEJELLY_DISABLE_API_AUTH=false
# CINEJELLY_DISABLE_API_RATE_LIMIT=false

# Optional API/server capacity settings. Defaults are conservative for a small
# single-node launch; raise them only after provider budget and storage are ready.
# [TINH NANG] Gioi han dung luong 1 file anh/video reference tai len qua UI (byte).
# Mac dinh 26214400 (25MB). Chi tang khi khach can video nguon lon hon.
# ============ [KINH DOANH] Tai khoan khach hang + nap credits ============
# Khach hang tao tai khoan (email + mat khau) va nap credits de tao video —
# khong bao gio can API key. Cac khoa duoi day deu co gia tri mac dinh tot.
#
# Gia render tinh bang credits/giay video (mac dinh 10). Vi du video 30s chat luong
# standard = 300 credits.
# CINEJELLY_CREDITS_PER_RENDER_SECOND=10
#
# Ti gia USD -> VND. Gia goi tinh theo USD (giong Higgsfield); so tien khach chuyen khoan
# = USD x ti gia nay. Mac dinh 27000. Doi so nay la TAT CA goi tu dong doi gia VND theo.
# (Cung chinh duoc trong tab Cau hinh cua Trung tam quan tri.)
# CINEJELLY_USD_TO_VND=27000
#
# Danh sach goi nap hien tren nut "Nap credits" (JSON). Mac dinh 4 goi theo USD:
# Trial $5/150cr, Starter $15/500cr, Plus $39/1400cr, Ultra $99/4000cr (credits KHONG het han).
# Moi goi can priceUsd (uu tien) hoac priceVnd. Vi du:
# CINEJELLY_CREDIT_PACKAGES_JSON=[{"packageId":"goi_thu","label":"Trial","credits":150,"priceUsd":5}]
#
# Huong dan chuyen khoan hien cho khach khi nap (dien STK ngan hang cua ban):
# CINEJELLY_TOPUP_BANK_INFO=Chuyen khoan toi: Vietcombank 0123456789 - NGUYEN VAN A. Noi dung: EMAIL cua ban. Sau khi chuyen bam nut xac nhan, admin se duyet trong it phut.
#
# [QUAN TRONG - CO SO DU LIEU] Chon noi luu du lieu tai khoan + so du khach hang.
# 3 lua chon, chi can doi 1 dong:
#   json     = file JSON don gian (mac dinh, khong can cai gi, hop voi luc moi ban)
#   sqlite   = CSDL SQL that (khuyen nghi khi co khach; can Node 22 - Docker da co san)
#   postgres = CSDL SQL lon, dam ben (khi co khach deu; can chay: npm install pg)
# CINEJELLY_DATABASE_KIND=json
#
# Duong dan file SQLite (chi dung khi chon sqlite; mac dinh canh file JSON):
# CINEJELLY_SQLITE_PATH=assets/output_deliverables/user-accounts.sqlite
#
# Chuoi ket noi Postgres (chi dung khi chon postgres):
# CINEJELLY_POSTGRES_URL=postgres://user:matkhau@localhost:5432/cinejelly
#
# DUNG NEON (Postgres dam may, mien phi de bat dau — RAT HOP vi Neon lo sao luu/ben du lieu):
#   1) Tao DB tren neon.tech, copy chuoi ket noi (chon endpoint "Pooled connection").
#   2) CINEJELLY_DATABASE_KIND=postgres
#   3) CINEJELLY_POSTGRES_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
#   4) npm install pg (mot lan tren may chu).
#   Luu y: van chay MOT tien trinh may chu (Neon cho do ben + sao luu, chua phai de chay
#   nhieu may chu cung luc). Neon co the "ngu" khi khong dung — request dau tien se hoi cham.
#
# Noi luu du lieu tai khoan/so du (mac dinh nam trong CINEJELLY_OUTPUT_DIR):
# CINEJELLY_USER_ACCOUNT_STORE_PATH=assets/output_deliverables/user-accounts.json

# CINEJELLY_UPLOAD_MAX_BYTES=26214400
# Tong dung luong toi da cua thu muc uploads (tat ca khach cong lai) — chong day o dia.
# Mac dinh 5GB. Khi day, nut tai len bao 507; chu he thong nen don thu muc uploads dinh ky.
# CINEJELLY_UPLOADS_TOTAL_MAX_BYTES=5368709120
# CINEJELLY_API_MAX_BODY_BYTES=1000000
# CINEJELLY_API_RATE_LIMIT_WINDOW_MS=60000
# CINEJELLY_API_RATE_LIMIT_MAX_REQUESTS=6
# CINEJELLY_API_SYNC_RENDER_CONCURRENCY=1
# CINEJELLY_API_JOB_CONCURRENCY=1
# CINEJELLY_API_JOB_HISTORY_LIMIT=100
# CINEJELLY_API_JOB_QUEUE_LIMIT=50

# Optional customer/client API policy.
# Store SHA-256 digests of customer API keys, not raw customer keys.
# Generate a digest locally with:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "customer-key"
# CINEJELLY_REQUIRE_CLIENT_POLICY_FOR_RENDER=false
# CINEJELLY_CLIENT_USAGE_LEDGER_PATH=assets/output_deliverables/client-usage/usage-ledger.jsonl
# Lich su job render duoc LUU MAC DINH (khach khong mat danh sach video khi restart).
# Dat "off" neu muon tat. Doi duong dan neu can:
# CINEJELLY_API_JOB_HISTORY_PATH=assets/output_deliverables/render-jobs/job-history.json
# CINEJELLY_API_CLIENTS_JSON=[{"clientId":"customer-a","keySha256":"<64_hex_sha256>","enabled":true,"monthlyRequestLimit":25,"monthlyReservedCostUsdLimit":100,"maxReservedCostUsdPerRequest":10,"defaultReservedCostUsdPerRequest":3,"maxDurationTargetSeconds":120,"allowedTiers":["mini","fast","standard"],"allowedQualityModes":["economy","standard"]}]

# Optional workspace billing policy. Use this when multiple customers/workspaces
# share one deployment and each needs independent quotas or spend caps.
# CINEJELLY_REQUIRE_WORKSPACE_FOR_RENDER=false
# CINEJELLY_WORKSPACE_USAGE_LEDGER_PATH=assets/output_deliverables/workspace-usage/usage-ledger.jsonl
# CINEJELLY_WORKSPACES_JSON=[{"workspaceId":"workspace-a","enabled":true,"displayName":"Workspace A","planId":"pilot","clientIds":["customer-a"],"monthlyRequestLimit":50,"monthlyReservedCostUsdLimit":200,"maxReservedCostUsdPerRequest":10,"defaultReservedCostUsdPerRequest":3,"projects":[{"projectId":"brand-a","enabled":true}]}]

# Approved operator budget for live validation gates. Keep this at a small
# number until you explicitly approve a full paid Atlas validation sequence.
CINEJELLY_LIVE_VALIDATION_MAX_BUDGET_USD=5
CINEJELLY_ATLAS_BILLING_EVIDENCE_MAX_AGE_HOURS=24

# Optional local/container deployment settings.
# PORT=8787
# CINEJELLY_OUTPUT_DIR=assets/output_deliverables
# CINEJELLY_REQUEST_TIMEOUT_MS=120000
# CINEJELLY_POLLING_INTERVAL_MS=5000
# CINEJELLY_POLLING_TIMEOUT_MS=1800000
